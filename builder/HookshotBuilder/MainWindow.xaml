<Window x:Class="HookshotBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mako Builder" Width="960" Height="600" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="Transparent" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource Ui}">

  <!-- One window, always 960x600: Windows 11's acrylic behind it (Glass.cs), Slate on Windows 10 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="18" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0C1730" Offset="0"/>
        <GradientStop Color="#FF060A14" Offset="0.65"/>
        <GradientStop Color="#FF05080F" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <!-- ===================== the start: the hookshot in the middle ===================== -->
    <Grid x:Name="Splash" RenderTransformOrigin="0.5,0.5" Panel.ZIndex="4">
      <Grid.RenderTransform><ScaleTransform x:Name="SplashScale"/></Grid.RenderTransform>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="260" Height="260">
          <Ellipse Margin="24" RenderTransformOrigin="0.5,0.5" x:Name="Halo">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#702E7BFF" Offset="0"/>
                <GradientStop Color="#002E7BFF" Offset="0.68"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale"/></Ellipse.RenderTransform>
          </Ellipse>
          <Image Source="pack://application:,,,/Images/mako.png" Width="240" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
              <TransformGroup>
                <RotateTransform x:Name="BobTurn"/>
                <TranslateTransform x:Name="BobLift"/>
              </TransformGroup>
            </Image.RenderTransform>
            <Image.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="14" Direction="270" Opacity="0.6" Color="Black"/></Image.Effect>
          </Image>
        </Grid>
        <TextBlock Text="M A K O" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock x:Name="SplashText" Text="Starting…" FontSize="13" Foreground="#A6FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" MinHeight="20"/>
        <Border Width="200" Height="3" CornerRadius="1.5" Background="#14FFFFFF" Margin="0,16,0,0" ClipToBounds="True">
          <Border Width="80" HorizontalAlignment="Left" CornerRadius="1.5">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0038C8FF" Offset="0"/>
                <GradientStop Color="#FF38C8FF" Offset="0.5"/>
                <GradientStop Color="#0038C8FF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.RenderTransform><TranslateTransform x:Name="Sweep"/></Border.RenderTransform>
          </Border>
        </Border>
      </StackPanel>
    </Grid>

    <!-- ===================== the installer ===================== -->
    <Grid x:Name="Main" Opacity="0" IsHitTestVisible="False">
      <Grid.RenderTransform><TranslateTransform x:Name="MainLift" Y="10"/></Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- the head: the hookshot, and the steps (or the update's versions) -->
      <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/Images/mako.png" Height="26" RenderOptions.BitmapScalingMode="HighQuality">
          <Image.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.5" Color="Black"/></Image.Effect>
        </Image>
        <TextBlock Text="MAKO" FontSize="15" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <Border x:Name="VersionChip" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="VersionChipText" FontSize="12" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"/>
        </Border>
      </StackPanel>

      <Border x:Name="StepPill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="4" Height="40" CornerRadius="20"
              Background="#0BFFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1">
        <StackPanel x:Name="StepItems" Orientation="Horizontal"/>
      </Border>

      <Grid Grid.Row="1" Margin="64,16,64,34">

        <!-- ===== 1: game files ===== -->
        <Grid x:Name="FilesPage">
          <!-- (the content scrolls and the Build button row stays: on a small or scaled screen the rows above pushed the
               buttons out of the fixed-size window, 2026-11-08) -->
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
          <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="FilesTitle" Style="{StaticResource Heading}" Text="Build your game"/>
            <TextBlock x:Name="FilesSub" Style="{StaticResource Sub}" Text="Pick your game files and where the game goes. Mako does the rest, once."/>
          </StackPanel>

          <StackPanel Grid.Row="1">
            <TextBlock x:Name="FoundLabel" Style="{StaticResource Label}" Text="FOUND ON THIS PC"/>
            <Border Style="{StaticResource Card}">
              <ScrollViewer MaxHeight="128" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DumpList"/>
              </ScrollViewer>
            </Border>
          </StackPanel>

          <WrapPanel Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="NotListed" Style="{StaticResource Note}" Text="Not listed?" Margin="0,0,8,0"/>
            <Button x:Name="BrowseButton" Style="{StaticResource LinkButton}" Content="Browse…" Click="BrowseNup"/>
            <TextBlock x:Name="DropNote" Style="{StaticResource Faint}" FontSize="13" Text=" · or drop the file on this window · " VerticalAlignment="Center"/>
            <Button x:Name="OtherWays" Style="{StaticResource LinkButton}" Foreground="{StaticResource InkSoft}" Content="romfs and exefs folders" Click="BrowseFolders"/>
          </WrapPanel>

          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="InstallLabel" Style="{StaticResource Label}" Text="INSTALL THE GAME TO"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="OutPath" Style="{StaticResource Path}" TextChanged="PathsChanged"/>
                <Button x:Name="ChangeButton" Grid.Column="1" Style="{StaticResource Quiet}" Margin="10,0,0,0" Content="Change" Click="BrowseOut"/>
              </Grid>
              <!-- the build files: how much, where (Storage.cs), and choosing the place -->
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="WorkNote" Style="{StaticResource Note}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="WorkChange" Grid.Column="1" Style="{StaticResource LinkButton}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                        Content="Change" Click="BrowseWork"/>
                <Button x:Name="WorkReset" Grid.Column="2" Style="{StaticResource LinkButton}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                        Content="Default" Click="ResetWork"/>
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock x:Name="LanguageLabel" Style="{StaticResource Label}" Text="GAME LANGUAGE"/>
              <ComboBox x:Name="LanguageBox" Style="{StaticResource Choice}" AutomationProperties.Name="Language" SelectionChanged="LanguageChanged"/>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" Foreground="#B9C8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="ToolsNote" Grid.Column="1" Style="{StaticResource Note}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
            <StackPanel Grid.Column="2">
              <TextBlock x:Name="WorkerLabel" Style="{StaticResource Label}" Text="BUILD WORKERS"/>
              <ComboBox x:Name="WorkerBox" Style="{StaticResource Choice}" IsEditable="False"
                        AutomationProperties.Name="Build workers" AutomationProperties.LabeledBy="{Binding ElementName=WorkerLabel}"
                        ToolTip="Automatic uses available memory and any existing worker override. More workers need more memory and may not be faster.">
                <ComboBox.FocusVisualStyle>
                  <Style TargetType="Control">
                    <Setter Property="Template">
                      <Setter.Value><ControlTemplate><Border BorderBrush="{StaticResource Brand}" BorderThickness="2" CornerRadius="10" Margin="-2"/></ControlTemplate></Setter.Value>
                    </Setter>
                  </Style>
                </ComboBox.FocusVisualStyle>
              </ComboBox>
              <!-- (make_game.py's last step, the game's prepare-shaders run: unticked, the game prepares them at its first start) -->
              <CheckBox x:Name="PrepareTick" Style="{StaticResource Tick}" Content="Prepare shaders now" IsChecked="True" Margin="0,12,0,0"
                        ToolTip="Prepares the game's shaders at the end of the build, a few minutes (longer on some GPUs). Unticked, the game prepares them at its first start, behind a black window."/>
            </StackPanel>
          </Grid>

          <!-- NVIDIA DLSS: off unless ticked. Ticking it shows NVIDIA's license; the build downloads NVIDIA's SDK under it
               (make_game.py, scripts/ngx_sdk.py). Nothing of NVIDIA's comes with the builder -->
          <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <CheckBox x:Name="DlssTick" Style="{StaticResource Tick}" IsChecked="False" Click="DlssChanged"
                      Content="NVIDIA DLSS (downloads NVIDIA's SDK under NVIDIA's license)"/>
            <TextBlock Style="{StaticResource Note}" FontSize="12" Margin="26,4,0,0" TextWrapping="Wrap"
                       Text="For NVIDIA RTX graphics cards. NVIDIA's files stay on this PC: never share a game folder built with them."/>
            <!-- AMD FSR 4: ticked by default in Mako. Nothing is downloaded: AMD's DLLs are put beside the game by hand (the readme) -->
            <CheckBox x:Name="FsrTick" Style="{StaticResource Tick}" IsChecked="True" Margin="0,10,0,0"
                      Content="AMD FSR 4 (AMD's files are not included: see the readme)"/>
            <TextBlock Style="{StaticResource Note}" FontSize="12" Margin="26,4,0,0" TextWrapping="Wrap"
                       Text="For AMD Radeon graphics cards. It is chosen in the game's Insert menu, as the Upscaler."/>
          </StackPanel>

          </Grid>
          </ScrollViewer>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ProgressBar x:Name="SpaceBar" Style="{StaticResource Bar}" Foreground="{StaticResource Go}" Width="160" VerticalAlignment="Center"/>
            <TextBlock x:Name="SpaceText" Grid.Column="1" Style="{StaticResource Note}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="AboutText" Grid.Column="2" Style="{StaticResource Faint}" Text="About 45 min" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <Button x:Name="BuildButton" Grid.Column="3" Style="{StaticResource Primary}" Content="Build the game" IsEnabled="False" Click="StartBuild"/>
          </Grid>
        </Grid>

        <!-- ===== 2: building (and the update) ===== -->
        <Grid x:Name="BuildPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid x:Name="RingBox" Width="120" Height="120" Margin="0,0,28,0">
              <Ellipse Stroke="#14FFFFFF" StrokeThickness="10" Margin="0"/>
              <Path x:Name="RingArc" Stroke="{StaticResource Brand}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <TextBlock x:Name="RingText" Text="0%" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="BuildTitle" Style="{StaticResource Heading}" Text="Building your game"/>
              <TextBlock x:Name="BuildNote" Style="{StaticResource Sub}"/>
              <ProgressBar x:Name="UpdateBar" Style="{StaticResource Bar}" Margin="0,18,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="0,22,0,14">
            <Border x:Name="StepCard" Style="{StaticResource Card}" Padding="18,6" VerticalAlignment="Top">
              <StackPanel x:Name="StageList"/>
            </Border>
            <TextBox x:Name="Log" Visibility="Collapsed" IsReadOnly="True" BorderThickness="1"
                     BorderBrush="{StaticResource GlassLine}" Background="#33000000" Foreground="{StaticResource InkSoft}"
                     FontFamily="{StaticResource Mono}" FontSize="11" Padding="10" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ToggleButton x:Name="ShowLog" Style="{StaticResource Link}" VerticalAlignment="Center" Content="Show details"
                          Checked="LogToggled" Unchecked="LogToggled"/>
            <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource Quiet}" Content="Cancel" Click="CancelBuild"/>
          </Grid>
        </Grid>

        <!-- ===== 3: ready ===== -->
        <StackPanel x:Name="ReadyPage" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid Width="84" Height="84" HorizontalAlignment="Center">
            <Ellipse Fill="{StaticResource GoSoft}">
              <Ellipse.Effect><DropShadowEffect Color="#5FB08A" BlurRadius="60" ShadowDepth="0" Opacity="0.55"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Margin="-10" Stroke="#125FB08A" StrokeThickness="10"/>
            <Path Data="M0,12 L10,22 L28,2" Stroke="{StaticResource Go}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="ReadyTitle" Style="{StaticResource Heading}" Text="Your game is ready" HorizontalAlignment="Center" Margin="0,24,0,0"/>
          <TextBlock x:Name="ReadyNote" Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
            <Button x:Name="PlayButton" Style="{StaticResource GoButton}" Click="Play">
              <StackPanel Orientation="Horizontal">
                <Path Data="M0,0 L11,7 L0,14 Z" Fill="{StaticResource GoInk}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="PlayText" Text="Play" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoInk}"/>
              </StackPanel>
            </Button>
            <Button x:Name="OpenButton" Style="{StaticResource Quiet}" Height="50" Margin="12,0,0,0" Content="Open folder" Click="OpenFolder"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <CheckBox x:Name="DesktopTick" Style="{StaticResource Tick}" Content="Desktop shortcut" IsChecked="True" Click="ShortcutsChanged"/>
            <CheckBox x:Name="StartTick" Style="{StaticResource Tick}" Content="Start menu entry" IsChecked="True" Margin="18,0,0,0" Click="ShortcutsChanged"/>
          </StackPanel>
          <!-- what the builder keeps on this PC for quick updates (Storage.cs), and letting it go -->
          <StackPanel x:Name="StorageRow" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,26,0,0" MaxWidth="560">
            <TextBlock x:Name="StorageNote" Style="{StaticResource Note}" TextAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Button x:Name="FreeButton" Style="{StaticResource LinkButton}" Content="Free up space" Click="FreeSpace"/>
              <Button Style="{StaticResource LinkButton}" Content="Show folder" Margin="18,0,0,0" Click="ShowStorage"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- ===== the launcher (Hookshot Launcher.exe in the game folder, started with launch and its folder) ===== -->
        <StackPanel x:Name="LaunchPage" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Label}" Text="THE LEGEND OF ZELDA" HorizontalAlignment="Center"/>
          <TextBlock Style="{StaticResource Heading}" Text="Ocarina of Time" HorizontalAlignment="Center" FontSize="34" Margin="0,4,0,0"/>
          <TextBlock x:Name="LaunchVersion" Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
          <TextBlock x:Name="LaunchStatus" FontSize="13" Foreground="{StaticResource InkSoft}" Text="Checking for updates…"
                     HorizontalAlignment="Center" Margin="0,16,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
            <Button x:Name="LaunchUpdate" Style="{StaticResource Primary}" Height="50" Padding="26,0" Margin="0,0,12,0" Content="Update"
                    Visibility="Collapsed" Click="LaunchUpdateClick"/>
            <Button x:Name="LaunchPlay" Style="{StaticResource GoButton}" Click="LaunchPlayClick">
              <StackPanel Orientation="Horizontal">
                <Path Data="M0,0 L11,7 L0,14 Z" Fill="{StaticResource GoInk}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Play" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoInk}"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Button x:Name="LaunchFolder" Style="{StaticResource LinkButton}" Foreground="{StaticResource InkFaint}" HorizontalAlignment="Center"
                  Margin="0,22,0,0" Content="Open the game folder" Click="LaunchFolderClick"/>
        </StackPanel>

        <!-- ===== when something goes wrong ===== -->
        <Grid x:Name="ProblemPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="ProblemTitle" Style="{StaticResource Heading}" Text="The build stopped"/>
            <TextBlock x:Name="ProblemSub" Style="{StaticResource Sub}" Text="Nothing was changed in your game folder."/>
          </StackPanel>
          <Border Grid.Row="1" CornerRadius="10" BorderThickness="1" BorderBrush="#55E2776B" Padding="24,22" Margin="0,22,0,14" VerticalAlignment="Top">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14E2776B" Offset="0"/>
                <GradientStop Color="#00E2776B" Offset="0.7"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Grid Width="28" Height="28">
                  <Ellipse Fill="{StaticResource BadSoft}"/>
                  <TextBlock Text="!" FontWeight="Bold" Foreground="{StaticResource Bad}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="ProblemHead" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="740"/>
              </StackPanel>
              <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock x:Name="ProblemText" Style="{StaticResource Note}" FontSize="14"/>
                  <StackPanel x:Name="ProblemSteps" Margin="0,8,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ProblemDetails" Style="{StaticResource LinkButton}" Foreground="{StaticResource InkSoft}" Content="Show details" Click="ProblemShowDetails"/>
              <TextBlock Style="{StaticResource Faint}" FontSize="13" Text="  ·  " VerticalAlignment="Center"/>
              <Button x:Name="CopyReport" Style="{StaticResource LinkButton}" Foreground="{StaticResource InkSoft}" Content="Copy for a bug report" Click="CopyForReport"/>
            </StackPanel>
            <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource Quiet}" Content="Back" Click="Back"/>
            <Button x:Name="RepairButton" Grid.Column="2" Style="{StaticResource Primary}" Content="Repair" Margin="10,0,0,0" Click="Repair"/>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- the window's own buttons, over everything -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Panel.ZIndex="9"
                WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource Caption}" Click="Minimize" ToolTip="Minimize">
        <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <Button Style="{StaticResource Caption}" Click="CloseWindow" ToolTip="Close">
        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
    </StackPanel>
  </Grid>
</Window>
