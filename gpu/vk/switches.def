// (hookshot) The renderer's switches: every RX_ name read from the environment, one row each, sorted by name.
//   SW(name, kind, type, "what the renderer does with it unset", "what setting it does")
//   GONE(name, "the day its reads were deleted", "what a run that still sets it gets")
// The kinds and the rules are in switches.h; tests/test_switch_table.py holds the table and the source to each other.
// The rows were first written on 2026-11-16 from a reading of each switch's code: where a row and the code disagree, the
// code is right and the row wants correcting.
SW(RX_NVN_TEXELS_LOG, diag, bool, "no logging", "Logs each WriteTexels/ReadTexels call with its data address, nonzero byte count and guest caller chain.")
SW(RX_NVN_WATCH_AFTER, diag, int, "0 s: writes are reported from the start", "Reports watched WriteTexels-source writes only after that many seconds.")
SW(RX_NVN_WATCH_ALL, diag, bool, "off: the Resource Memory thread's writes are not reported", "Reports watched writes from the Resource Memory thread too.")
SW(RX_NVN_WATCH_TEX, diag, string, "off", "Page-watches the storage of textures of the given <w>x<h> size and logs who writes it, with call stacks.")
SW(RX_NVN_WATCH_TEXELS_SRC, diag, string, "off", "Page-watches the source data of WriteTexels uploads into textures of the given <w>x<h> size and logs later writes to it.")
SW(RX_VK_9E5_SWAP, diag, bool, "off", "Swaps R and B in sampled views of RGB9E5 textures, for diagnosing a colour-order fault.")
SW(RX_VK_ALLOWED_AT_COUNT, kill, bool, "on: an allowance equal to the count once past it is taken as a tenth under the count", "=0 takes the driver's VRAM allowance as reported, even when it just follows the process's use.")
SW(RX_VK_ALL_COMPONENTS, kill, bool, "colour write mask limited to the components the fragment shader writes", "1 turns off the amd-fix that masks out colour components the fragment shader does not write.")
SW(RX_VK_ALL_GLOBAL_PROGS, diag, string, "unset: none", "Comma list of compute program key prefixes none of whose memory accesses are bound to a descriptor (a test).")
SW(RX_VK_ANISO, player, int, "the Insert menu's anisotropic filtering row", "Anisotropy 0 to 16 (0: the game's own) over the menu row for one run.")
SW(RX_VK_ANTILAG, player, enum, "the Insert menu's AMD Anti-Lag 2 row (opts.antilag)", "0/1 overrides the Anti-Lag 2 menu row for one run; '-' leaves the VK_AMD_anti_lag extension not even enabled.")
SW(RX_VK_ASTC_BC7, attempt, bool, "off: big ASTC textures are re-encoded as BC3", "=1 re-encodes big ASTC textures as BC7 instead of BC3, for better gradients and alpha.")
SW(RX_VK_ASTC_BC_ALL, hw, bool, "on when the driver's VRAM allowance is small or the GPU is integrated (astc_bc_policy::all), off elsewhere", "Forces keeping all large decoded ASTC textures as BC3 (1) or only the coarse-block ones (0) on any card.")
SW(RX_VK_ASTC_BC_MB, tune, int, "1 MB", "Size as RGBA8, in MB, from which a coarse-block decoded ASTC texture is re-encoded as BC3.")
SW(RX_VK_ASTC_CPU, hw, bool, "on for AMD Ryzen 7000/9000 desktop integrated graphics (0x164E, 0x13C0) on Windows, off elsewhere", "Decodes ASTC textures on the CPU (to RGBA8) instead of with the GPU decoder; 0 forces the GPU.")
SW(RX_VK_ASTC_REUSE, kill, bool, "on: a new texture with the blocks of a finalized one takes its decoded image by a GPU copy", "=0 decodes every new ASTC texture, as before.")
SW(RX_VK_ASTC_RGBA8, player, bool, "the menu's ASTC as RGBA8 row (off)", "Decodes ASTC textures to RGBA8 instead of BC for one run, over the Developer row, which it then fixes.")
SW(RX_VK_ASYNC, player, int, "the Threaded rendering row (Auto: by CPU count and whether the run is safe)", "Non-zero runs the replay on a render thread, 0 on the submitting thread, over the Threaded rendering row.")
SW(RX_VK_ASYNC_IMPORT, attempt, bool, "off: imports are made on the replay thread", "1 imports a newly bound range in the background and serves the binding from a stream copy meanwhile.")
SW(RX_VK_AUTO_PRESET, kill, bool, "on (1)", "=0 makes a first start keep the plain defaults instead of the Auto (this PC) Quality preset.")
SW(RX_VK_AUTO_PRESET_VRAM_MB, diag, int, "the card's real video memory", "Pretends the card has this many MB of video memory when Auto (this PC) chooses its settings.")
SW(RX_VK_AUTO_TUNE, kill, bool, "on (1)", "=0 stops Auto (this PC) measuring the GPU in play and stepping its Render resolution.")
SW(RX_VK_AVAIL_RESERVE_MB, tune, int, "1536 MB (0 turns the check off)", "Physical RAM (MemAvailable) the renderer leaves free on Linux before it frees its own.")
SW(RX_VK_B2T_CPU, kill, bool, "off: buffer-to-texture copies run on the GPU, except ASTC into a decoded image", "Does all buffer-to-texture copies on the CPU through the texture's storage.")
SW(RX_VK_BANK_GEN_OFF, kill, bool, "a stage's bank is reused while its own textures or storage buffers stand", "1 reuses a stage's descriptor bank only while nothing at all was bound anew, as before.")
SW(RX_VK_BARE_READ_MB, tune, int, "min(maxStorageBufferRange, 1 GB) minus 64 KB, at least 1 MB", "Caps in MB how far a size-less read-only storage buffer table entry is bound towards its pool's end.")
SW(RX_VK_BARRIER_DEDUPE_OFF, kill, bool, "off: a full barrier right after another on the same command buffer is left out", "Records every full barrier again instead of leaving out the second of two in a row.")
SW(RX_VK_BARRIER_EVERY_DRAW, attempt, bool, "off", "Ends the pass before every draw, so each draw gets a pass of its own.")
SW(RX_VK_BATCH, hw, bool, "on with Mesa RADV except on GCN cards (64-lane waves), off elsewhere", "Turns batching of queue submits on or off.")
SW(RX_VK_BATCH_IDLE, kill, bool, "on", "=0: batched submits are held until a wait, present or the cap even while the GPU is idle, as before.")
SW(RX_VK_BATCH_MAX, tune, int, "32 command buffers", "The most command buffers held in one batched submit before it is sent.")
SW(RX_VK_BATCH_POLL_US, tune, int, "2000 us", "A progress poll sends held submits only once the oldest has waited this many microseconds (0: always).")
SW(RX_VK_BC_IDLE_S, tune, int, "0: the BC scratch images are kept once made", "Seconds of disuse after which the ASTC-to-BC scratch images are given back; 0 never.")
SW(RX_VK_BC_LAYERS, tune, int, "1 (clamped 1-8)", "How many layers the ASTC-to-BC scratch images have, which is how many one run decodes and encodes.")
SW(RX_VK_BC_POOL, attempt, bool, "off: the BC scratch images each get a dedicated allocation", "=1 takes the two ASTC-to-BC scratch images from the shared image pool instead of dedicated allocations.")
SW(RX_VK_BC_STORAGE, kill, bool, "on: compressed images get STORAGE usage when the raw format supports it", "=0 makes block-compressed images without storage usage, as before v2.0.8 on AMD, so the game's BC encoders do not run there.")
SW(RX_VK_BENCH, diag, string, "no benchmark", "Replays the frame at the given present repeatedly (<present>[,<times>], 50 times) to time it.")
SW(RX_VK_BG_IMPORT, attempt, bool, "off: pools are imported by chunk at first use", "1 imports every pool the game makes eagerly on a background thread.")
SW(RX_VK_BLOCK_BUFFERS, kill, bool, "off: buffers asked as dedicated get a memory object of their own", "Puts buffers asked as dedicated into VMA's shared blocks instead, as before.")
SW(RX_VK_BLOCK_PROBE, diag, bool, "off (512-byte miss-log slices)", "Set, counts entries into each IR block of the probed programs (16 KB slices) and writes them in the stats dump.")
SW(RX_VK_BUDGET_BY_BLOCKS, kill, bool, "off: the budget's excess is measured less the free space in VMA's blocks", "Measures VRAM pressure by the allocator's blocks alone, as before, and turns off the compaction's hold line.")
SW(RX_VK_CAPTURE, kill, bool, "on: written pages are captured at each submit", "0 turns off the submit-time capture of written pages; the replay collects them itself, as before.")
SW(RX_VK_CAPTURE_EAGER, tune, int, "0: new pools stay in the captures with no limit", "Keeps a newly made pool in the captures only for its first n captures.")
SW(RX_VK_CAPTURE_KEEP_OLD, kill, bool, "off: buffers up to 256 MB reused, size classes 32/64/128/192/256 MB", "1 goes back to the former capture buffer size classes and the 64 MB reuse limit.")
SW(RX_VK_CAPTURE_NT, attempt, bool, "off: memcpy", "1 copies captures with non-temporal stores instead of memcpy.")
SW(RX_VK_CAPTURE_POOL_MB, tune, int, "64 MB", "Largest game pool, in MB, that joins the captures from when it is made; 0 takes none.")
SW(RX_VK_CAPTURE_THREADS, hw, int, "4 helper threads with 12 or more CPU threads, else 2; 0 with RX_VK_LOW_SPEC", "Number of helper threads (0-4) that share a capture's page copies with the submitting thread.")
SW(RX_VK_CAPTURE_WAIT, kill, enum, "2: the replay handles a capture's late pages, the game's thread does not wait", "1 makes the game's thread wait for write-backs of a capture's late pages; 0 does no wait at all.")
SW(RX_VK_CAP_BLOCKS, attempt, bool, "off: capture buffers of 16 MB and up each get dedicated memory", "1 allocates large capture buffers from shared memory blocks instead of dedicated memory.")
SW(RX_VK_CAP_MIN_MB, tune, int, "2 MB", "The smallest capture buffer size class in MB; 16 is the old behaviour.")
SW(RX_VK_CAP_PREWARM, kill, bool, "on: 32, 64 and 128 MB spare capture buffers are made ahead on a worker thread", "0 stops making big capture buffers ahead, so they are allocated on the game's thread at scene loads.")
SW(RX_VK_CAP_SPARE_MB, hw, int, "32 MB of spare capture buffers on cards allowing 6.5 GB or less; no byte limit elsewhere", "Sets how many MB of spare capture buffers are kept for reuse; 0 means no limit, as before.")
SW(RX_VK_CASCADE_BIAS, tune, string, "0,0: nothing added", "Adds a depth bias <units>,<slope> to the sun's shadow cascades.")
SW(RX_VK_CATCHUP_FORCE, kill, bool, "off: a catch-up lets on only the event waits that are met", "=1 makes a catch-up force every queue stopped at an event wait past it, as before.")
SW(RX_VK_CHECKPOINTS, kill, enum, "on: NVIDIA diagnostic checkpoints before each draw where the driver has the extension", "0 turns off draw checkpoints; ext enables the extension only; 1 also uses AMD buffer markers where NV's are missing.")
SW(RX_VK_CHECK_BANKS, diag, bool, "off: no check", "Compares each constant-bank fill against the per-word path and logs up to 20 mismatches.")
SW(RX_VK_CHUNK, tune, int, "120 draws and dispatches a part", "Draws and dispatches per part a long submission is cut into; 0 sends it whole.")
SW(RX_VK_CLEAR_CPU_MAX, tune, int, "256 bytes", "Largest buffer clear also applied on the CPU in stream order; 0 leaves every clear to the GPU.")
SW(RX_VK_CLEAR_IN_PASS, kill, bool, "off: a clear after draws ends the pass and gets one of its own", "Keeps a clear after draws inside the open pass, as before.")
SW(RX_VK_COLD_CHECK, kill, bool, "on: 48 noted pipelines are asked of the driver's cache at start", "=0 skips the check that reruns the warm pass when the driver's shader cache has lost the noted pipelines.")
SW(RX_VK_COMMIT_GROWTH, kill, bool, "on: what the page files can still grow by counts as commit headroom", "=0 counts only Windows' commit limit as it is now, as before.")
SW(RX_VK_COMMIT_RESERVE_MB, tune, int, "2560 MB (Windows commit rule); Linux pressure uses linux_pressure.h's own default", "Sets how many MB of commit (or swap, on Linux) the textures leave free for the rest of the system; 0 turns the rule off.")
SW(RX_VK_COMPACT, kill, bool, "on: sampled textures in a pool of their own, compacted", "=0 (or empty) turns off the texture pool's compaction and its separate pool.")
SW(RX_VK_COMPACT_MB, hw, int, "a sixteenth of the driver's VRAM allowance, clamped to 64-512 MB (512 when unknown)", "Sets how many MB must be free in the textures' pool before a VRAM compaction run starts.")
SW(RX_VK_COMPACT_PCT, tune, int, "80 % of the driver's allowance", "Sets the share of the VRAM allowance the compaction holds the texture count at, clamped to 50-90.")
SW(RX_VK_COMPILE_SHADERS, player, enum, "compile_shaders in hookshot_options.ini, else the built-in default", "What a preparation builds: all (the predicted pipelines too) or most.")
SW(RX_VK_COMPUTE_QUICK_FIRST, player, bool, "the Intel quick compute builds row (on)", "=0 stops Intel compute pipelines being built first without the driver's optimizer, over the menu row.")
SW(RX_VK_COMPUTE_SERIAL, hw, bool, "on for Intel (vendor 0x8086), off elsewhere", "1 or 0 says on any GPU whether compute pipelines are built one at a time on a thread of their own.")
SW(RX_VK_COMPUTE_WAIT, kill, bool, "off: compute pipelines compile on a worker, the dispatch waits up to 50 ms then is left out", "Waits for each compute pipeline's compile at the dispatch, as before.")
SW(RX_VK_COND_ALWAYS, diag, bool, "off: render conditions are evaluated", "=1 (test) makes every conditional-render condition hold, so everything conditional is drawn.")
SW(RX_VK_COUNT_BY_ESTIMATE, kill, bool, "off: the budget counts what the allocator gave each image", "Counts texture memory by the texels' estimated size instead of the allocation's real size, as before.")
SW(RX_VK_CPU_OVER_GPU, attempt, bool, "off: CPU writes are taken over GPU contents only for textures the GPU merely cleared", "Takes whole pages the CPU wrote after a GPU write over any GPU-written texture, not only cleared ones.")
SW(RX_VK_DEAD_EVERY, tune, int, "1 present", "Sets how often, in presents, dead transient render targets are looked for.")
SW(RX_VK_DEAD_MIN_UNUSED, tune, int, "1 present (3 before)", "Sets how many presents a dead transient render target must go unused before it is let go.")
SW(RX_VK_DEAD_TARGETS, kill, bool, "on: dead transient render targets are let go between eviction passes", "=0 leaves dead transient render targets for the 600-present sweep or the budget, as before.")
SW(RX_VK_DEFERRED_LATE, kill, bool, "off: deferred binds use the ranges copied at the submit", "=1 reads deferred buffer binds from the game's arrays at the replay, the old way that misplaced MKW terrain.")
SW(RX_VK_DESC_COUNTS, kill, bool, "on: a program's descriptor counts are taken once and kept", "=0 counts the program's descriptors again before every descriptor build, as before.")
SW(RX_VK_DESC_POOL_DIV, tune, int, "1 (8192 sets, full-size pools)", "Makes each recording's descriptor pool an n-th (1 to 32) of its size, for the memory the driver keeps.")
SW(RX_VK_DESC_REUSE, player, enum, "the Descriptor reuse menu row / descriptor_reuse in hookshot_options.ini; On (level 2) with no line", "Overrides the Descriptor reuse row for a run: 0 its Off, 1 its On, never: every draw builds its own descriptors.")
SW(RX_VK_DEVICE, player, int, "unset: the menu's GPU device row, else the best-scored GPU", "Picks the graphics card by its index in the log, over the menu's GPU device.")
SW(RX_VK_DLSS, player, enum, "the Insert menu's Upscaler row", "0 never DLSS (NGX's extensions not enabled), 1 DLSS, 2 DLAA, over the Upscaler row for one run.")
SW(RX_VK_DLSS_ACTORS, kill, bool, "on: skinned actors' motion vectors made for the temporal upscalers", "=0 turns off per-actor motion vectors for DLSS, FSR 4, XeSS and frame generation.")
SW(RX_VK_DLSS_ACTOR_LIVE, kill, bool, "off: poses are read at the draw from the stream's view", "=1 copies every actor's pose from the GPU's buffer at the upscale, as before, for an A/B.")
SW(RX_VK_DLSS_ACTOR_REACH, tune, float, "60 world units a second", "How far apart, in world units a second, two copies of a model may be and still pair for actor motion.")
SW(RX_VK_DLSS_ACTOR_TOL, tune, int, "64", "Tolerance used when pairing an actor's pose with its pose of the frame before.")
SW(RX_VK_DLSS_DEBUG, diag, enum, "unset: no debug view", "motion shows the motion vectors; alternate shows the game's own upscale every other frame as a test reference.")
SW(RX_VK_DLSS_DIR, player, string, "the game folder's ngx, then the user's Hookshot/ngx data folder", "Names another folder NGX looks in first for the DLSS and frame generation runtimes.")
SW(RX_VK_DLSS_FG, player, enum, "the Insert menu's Frame generation by row", "0 rules DLSS frame generation out for the run, 1 forces it, over the Frame generation by row.")
SW(RX_VK_DLSS_FG_INVALID, attempt, bool, "FLT_MAX is the 'no motion here' value", "0 makes zero the invalid motion vector value given to DLSS-G, as the Streamline path has it.")
SW(RX_VK_DLSS_FG_MOST, diag, int, "as many generated frames as the runtime offers", "Caps the number of frames DLSS-G may make per game frame, to imitate an older runtime in checks.")
SW(RX_VK_DLSS_FG_MV_SCALE, diag, float, "1.0", "Multiplies the motion vector scale given to DLSS-G, for checks.")
SW(RX_VK_DLSS_HDR, kill, bool, "on (DLSS's HDR feature when the game presents native PQ)", "0 keeps DLSS's LDR feature and clamped colour even with native HDR, for comparisons.")
SW(RX_VK_DLSS_IDLE_RELEASE, kill, bool, "off: the engine is kept while it is still the Upscaler's choice", "=1 lets go of the upscaler's feature and images after 120 unused frames, as before.")
SW(RX_VK_DLSS_JITTER, kill, bool, "on: the camera is jittered while a temporal engine draws", "=0 turns off the sub-pixel camera jitter given to the temporal upscalers.")
SW(RX_VK_DLSS_LOD_OFFSET, tune, float, "-1", "DLSS's LOD bias offset in mip steps, clamped to -3..0 (0: the render size's own detail).")
SW(RX_VK_DLSS_LOG, diag, bool, "off (NGX writes its own log files only)", "1 sends NGX's own log lines into the renderer's log instead of NGX's files.")
SW(RX_VK_DLSS_PRESET, player, string, "the DLSS model row's preset (K, or E under 7 GB of VRAM)", "A preset letter (or 0 for NVIDIA's default) over the DLSS model menu row for one run.")
SW(RX_VK_DLSS_TRACE, diag, int, "0: off", "Every <n> frames, logs one frame's draws into scene-sized targets for the temporal upscaler's motion.")
SW(RX_VK_DMABUF_PIECE_MB, tune, int, "udmabuf's size limit from /sys (64 MB unless raised)", "Caps each dma-buf piece of a pool at n MB, to try the sparse multi-piece path with the kernel limit raised.")
SW(RX_VK_DRAW_STATS, diag, string, "unset: no statistics", "Names a folder: one measured frame's per-draw statistics and the wanted programs' descriptors and buffers are written there.")
SW(RX_VK_DRAW_STATS_PROGS, diag, string, "no programs dumped", "A list of hex program keys whose uniform and storage buffers are dumped in hex with the frame statistics.")
SW(RX_VK_DREF_FROM_SAMPLER, kill, bool, "a comparing shader gets a comparing sampler", "1 keeps the old behaviour: the sampler compares only when the game's sampler asks for it.")
SW(RX_VK_DRIVER_FAULTS, kill, enum, "1: programs the driver faulted on are left out, this run and later ones", "0 asks the driver again for programs it faulted on; 2 builds one program at a time on every driver.")
SW(RX_VK_DROP_MODULES, hw, bool, "Linux: on with 20 GB of RAM or less or a memory shortfall at start, off otherwise", "Forces the shader modules to be let go (1) or kept (0) after the precompile.")
SW(RX_VK_DRY_LAST_KEPT, kill, bool, "off: each dry pass forgets the last draw's targets", "Keeps the last dry pass's targets across passes, as before the black-frame fix.")
SW(RX_VK_DUMP, diag, string, "no dump", "Dumps every step of the frame after the given present(s) as PNGs: <present>[+<count>][,...].")
SW(RX_VK_DUMP_9E5, diag, bool, "off", "Frame dumps read B10G11R11 targets back raw through the depth route instead of as colour.")
SW(RX_VK_DUMP_ARGS, diag, string, "empty: none logged", "In a dump, logs each draw of the listed programs (1: all) with its arguments and vertex buffers.")
SW(RX_VK_DUMP_BLACK, diag, int, "0: off", "<n> dumps the next frame after a shot with 12-90% black pixels or a green cast, n times at most.")
SW(RX_VK_DUMP_DEPTH_ONLY, diag, bool, "off", "Frame dumps leave the passes' colour targets out and write depth only.")
SW(RX_VK_DUMP_DIR, diag, string, "RX_VK_SHOTS, else the current folder", "Folder the frame dumps' dump_<present> folders are made in.")
SW(RX_VK_DUMP_EACH, diag, string, "empty: none", "In a dump, gives each draw of the listed programs a pass of its own so each is dumped separately.")
SW(RX_VK_DUMP_FAILED, diag, string, "unset: nothing written", "Folder that receives the native code of each program that fails to lower, <stage>_<key>.bin.")
SW(RX_VK_DUMP_FILE, diag, string, "unset", "<path>: that file appearing dumps the next frame and is deleted.")
SW(RX_VK_DUMP_KEY, diag, bool, "off", "=1 makes F9 dump the next frame, 8 times at most.")
SW(RX_VK_DUMP_KEY_N, diag, int, "1 frame", "How many frames each F9 press dumps (with RX_VK_DUMP_KEY).")
SW(RX_VK_DUMP_LIVE, diag, bool, "off (storage buffers dumped as submitted)", "1 makes the stats dump read storage buffers as guest memory holds them now, not as submitted.")
SW(RX_VK_DUMP_MESH_SPV, diag, string, "unset: nothing written", "Folder that receives each stage's SPIR-V of the mesh programs translated, for spirv-val.")
SW(RX_VK_DUMP_MOD, diag, string, "unset", "<m>,<r>[,<n>]: the dump file arms the next n frames (2) whose present is r mod m.")
SW(RX_VK_DUMP_NATIVE, diag, string, "unset: nothing written", "Comma list of program key prefixes whose native NVN2 code is written to a file.")
SW(RX_VK_DUMP_NOPNG, diag, bool, "off: PNGs are written", "Frame dumps log their statistics only and write no PNG.")
SW(RX_VK_DUMP_ONLY_W, diag, string, "targets of every width dumped", "Frame dumps write only targets of the listed widths.")
SW(RX_VK_DUMP_ON_WATCH, diag, int, "0: off", "Number of frames to dump, once, after a texture RX_VK_WATCH_TEX names is made after boot.")
SW(RX_VK_DUMP_PIXELS, diag, string, "no texels logged", "Logs the listed x,y texels of each dumped picture.")
SW(RX_VK_DUMP_PROGS, diag, string, "every step dumped", "Narrows a frame dump to the steps of the listed program keys.")
SW(RX_VK_DUMP_RAW, diag, bool, "off", "Frame dumps also write float pictures as raw RGBA32F .f32 files.")
SW(RX_VK_DUMP_SAMPLED, diag, string, "empty list: nothing extra dumped", "In a dump, also writes the textures the listed programs (hex keys) sample, each once, 96 at most.")
SW(RX_VK_DUMP_SPV, diag, string, "unset: nothing written", "Folder that receives the SPIR-V of translated compute programs, <key>.spv, for spirv-val.")
SW(RX_VK_DUMP_SSBO, diag, string, "empty: none dumped", "In a dump, writes the listed programs' storage buffers, as guest memory and as the GPU hold them.")
SW(RX_VK_DUMP_STAGES, diag, string, "unset: nothing written", "Folder that receives each shader stage's control and code as the game has them, <key>.bin.")
SW(RX_VK_DUMP_STEPS, diag, string, "every step dumped", "Narrows a frame dump to the steps lo-hi.")
SW(RX_VK_DUMP_W, diag, int, "320 pixels (16 to 4096)", "Width of the scaled pictures a frame dump writes.")
SW(RX_VK_DYN_PROG_KEY, kill, bool, "off: dynamic state is keyed by the program's write-mask signature", "Keys the dynamic state by the program itself, as before, so each program change works the state out again.")
SW(RX_VK_EQ_BIAS, hw, float, "64 on Intel (vendor 0x8086), 0 (off) elsewhere", "Sets the margin that turns EQUAL depth tests into LESS_OR_EQUAL with a bias; 0 is as the game asks.")
SW(RX_VK_EVENT_WAITS, kill, bool, "on", "=0 turns off stopping a queue's replay at its event waits; submissions replay past them.")
SW(RX_VK_EVICT_EXCESS, kill, bool, "on: the 90% rule and the driver's limit evict only their excess", "=0 makes those rules evict down to 7/8 of their budget, as before.")
SW(RX_VK_EVICT_MIN_UNUSED, tune, int, "60 frames (8 before)", "Sets how many frames a texture must go unused before an over-budget eviction may take it.")
SW(RX_VK_EVICT_NO_FLUSH, kill, bool, "off: an evicted GPU-drawn texture is written back into guest memory first", "Evicts GPU-drawn textures without writing their texels back to guest memory, as before.")
SW(RX_VK_EVICT_RENDERED, kill, bool, "off: live GPU-written textures are kept from eviction by several rules", "Lets the eviction take textures the GPU wrote and the game still has, as before.")
SW(RX_VK_EVICT_UNFLUSHABLE, kill, bool, "off: live GPU-drawn textures under 256 MB that cannot be written back are kept", "Evicts live GPU-drawn textures whose texels cannot be written back to guest memory, as before.")
SW(RX_VK_EXPOSURE_LOG, diag, enum, "unset: off", "Keeps the exposure word of the last 32 frames for a white-frame dump; 2 logs it every frame.")
SW(RX_VK_FALLBACK_DEPTH_HOLD, kill, bool, "on: a mesh fallback's depth-only draw is held while its colour draw is not built", "=0 lets depth-only fallback draws run before their colour draws are built.")
SW(RX_VK_FALLBACK_LOADED, kill, bool, "on", "=0: the start no longer makes compute pipelines for mesh fallback programs read in earlier in the same start.")
SW(RX_VK_FALLBACK_PHI_LIMIT, tune, int, "50000 phis; applied only on RADV GCN 1-4 cards", "Sets the phi count above which a mesh fallback compute stage is not built on RADV GCN cards; 0: no limit.")
SW(RX_VK_FAULT_INFO, diag, bool, "off: device fault info is read only when there are no checkpoints or buffer markers", "At a device loss, also queries the driver's fault info, before and after the checkpoint report.")
SW(RX_VK_FETCH_BOUNDS, hw, bool, "on for every GPU but NVIDIA's (vendor id != 0x10DE), off on NVIDIA", "Forces the shader-side zero answer for out-of-bounds texel fetches off (0) or on (non-zero), whatever the GPU.")
SW(RX_VK_FIFO, player, bool, "the menu's V-Sync row", "V-Sync On (FIFO) for one run, over the menu's V-Sync row.")
SW(RX_VK_FLASH, diag, bool, "off", "=1 runs the flash detector on shots: writes the three frames around a one-frame flash and dumps the next.")
SW(RX_VK_FLASH_CELLS, diag, int, "40", "How many cells must flash for the detector to report one.")
SW(RX_VK_FLASH_DIFF, diag, int, "48", "Per-cell brightness difference the flash detector counts as a flash.")
SW(RX_VK_FLASH_DUMPS, diag, int, "6", "How many frame dumps the flash detector may ask for.")
SW(RX_VK_FLASH_RECORD, diag, string, "no draws recorded", "Records the draws of the listed program keys (hex, comma separated) per frame for flash hunting.")
SW(RX_VK_FLASH_REGION, diag, int, "0: off", "<level> also reports a 16x9 block whose mean brightness jumps by that level for one frame, while the picture moves.")
SW(RX_VK_FLUSH_UNCACHED, kill, bool, "off: texture write-backs read from cached host memory", "Reads texture write-backs from the uncached sequential-write staging memory, as before.")
SW(RX_VK_FOLLOW_GRAPHICS, kill, bool, "on (vertex and fragment stages follow global memory as the fallback)", "0 stops graphics stages following global memory accesses through the page table push block.")
SW(RX_VK_FOLLOW_STORES, attempt, bool, "off: only loads follow pointers through the page table", "1 lets shader writes and atomics follow pointers through the guest page table too.")
SW(RX_VK_FOOTPRINT, diag, string, "empty: no program changed", "Makes the listed programs' draws write depth wherever they rasterize, to show their footprint in dumps.")
SW(RX_VK_FOOTPRINT_LINES, diag, bool, "off", "Draws the RX_VK_FOOTPRINT programs as wireframes.")
SW(RX_VK_FORCE_LINEAR, diag, bool, "off (the game's filters)", "1 makes every sampler linear, for an A/B of the nearest-filter artifacts.")
SW(RX_VK_FORCE_MESH_FALLBACK, diag, bool, "off: RX_VK_MESH_SHADERS or the automatic rule decides", "A test: forces the compute fallback for task and mesh programs where the GPU has mesh shaders.")
SW(RX_VK_FORCE_UPSCALE_STUB, diag, int, "0: networks take the fallback only where they fail or are slow", "A test: 1 sends upscale networks other than gameplay's to the fallback stub, 2 all of them.")
SW(RX_VK_FRAG_SHUFFLE_FALLBACK, hw, bool, "on for AMD's proprietary driver, off elsewhere", "0 or 1 forces fragment-stage subgroup shuffles native or through broadcasts, whatever the driver.")
SW(RX_VK_FRAMEGEN, kill, bool, "allowed: the menu's Frame generation row decides", "=0 keeps frame generation off whatever the menu says.")
SW(RX_VK_FRAMEGEN_MULT, player, int, "the options file's frame generation row", "Sets the frame generation multiplier (2 to 8) for one run, over the options file.")
SW(RX_VK_FRAMEGEN_RADIUS, tune, int, "8 (1 to 16)", "Search radius of the built-in frame generation's block matching, in quarter texels.")
SW(RX_VK_FRAMELOG, diag, string, "unset: no frame log", "<path> records every presented frame at 320x180 with its time, and traps dark frames.")
SW(RX_VK_FRAMELOG_DROP, diag, bool, "off", "=1 keeps the frame log's readback and dark-frame trap but writes no records.")
SW(RX_VK_FRAME_GATE, kill, bool, "on whenever the render thread is on (async_on)", "=0 replays the render thread's jobs as they come instead of holding a frame's jobs until its present.")
SW(RX_VK_FRAME_GATE_MS, tune, int, "1000 ms", "How long the frame gate holds a job with no present behind it before letting it on, in ms.")
SW(RX_VK_FRAME_LOG, diag, string, "unset: no file", "<file> writes one CSV line a present: frame, seconds since the first, frame time in ms.")
SW(RX_VK_FRAME_TRACE, diag, bool, "off: no frame trace", "Writes a line a present to hookshot_frames.csv with what the frame did and waited for.")
SW(RX_VK_FSR, player, int, "unset: the menu's Upscaler row decides", "0 never runs FSR 3.1, 1 runs it over the Upscaler row and over RX_VK_DLSS / RX_VK_FSR4.")
SW(RX_VK_FSR3_CHAIN, kill, bool, "on: FSR 3.1 draws on the temporal chain", "=0 runs FSR 3.1 with its own inputs (vk_fsr3_inputs.cpp), as before.")
SW(RX_VK_FSR4, player, int, "unset: the menu's Upscaler row decides", "0 never runs AMD FSR 4, 1 runs FSR 4 and 2 its Native AA over the Upscaler row.")
SW(RX_VK_FSR4_HDR, kill, bool, "on: FSR 4 takes the game's HDR colour while it presents PQ", "=0 keeps FSR 4's LDR context and clamped colour with native HDR too.")
SW(RX_VK_FSR4_TUNE, hw, bool, "on for AMD GPUs, off elsewhere", "=0 runs AMD's FSR 4 passes as AMD made them instead of the tuned rebuilds.")
SW(RX_VK_FSR4_UNROLL, kill, bool, "on: the tuned FSR 4 passes have their layers unrolled", "=0 leaves the FSR 4 network's layers rolled in the tuned passes.")
SW(RX_VK_FSR_DIR, diag, string, "AMD's DLLs looked for beside the executable and in the game folder", "Another folder AMD's FSR 4 library is looked for in first.")
SW(RX_VK_FSR_FG, player, int, "unset: the menu's Frame generation and Frame generation by rows decide", "0 never asks for FSR 3.1 frame generation, 1 asks for it over the row.")
SW(RX_VK_FSR_FG_HUD, kill, bool, "on: the patched passes keep the HUD static", "=0 uses AMD's interpolation passes as they were, the HUD moving with the scene, for an A/B.")
SW(RX_VK_FSR_JITTER, kill, bool, "on: FSR 3.1 jitters the camera", "=0 gives FSR 3.1 no camera jitter, on the chain and with its own inputs.")
SW(RX_VK_GATHER_OFFSET, hw, bool, "on for AMD (proprietary, open source, RADV), Intel (Windows, Mesa), Qualcomm and Turnip drivers; off elsewh...", "Forces the 1/512-texel nudge on texture gathers off (0) or on (non-zero), whatever the driver.")
SW(RX_VK_GM_LOOP, hw, bool, "on for Intel's Mesa driver (ANV), off elsewhere; needs dynamic indexing of storage buffer arrays", "1 searches a global memory access's storage buffer tables in a loop, 0 writes them out entry by entry.")
SW(RX_VK_GPL, attempt, bool, "off (no stage libraries)", "1 turns on graphics pipeline libraries where the device has them and the dynamic state they need.")
SW(RX_VK_GPL_NO_CACHE, kill, bool, "stage libraries go through the pipeline cache", "1 keeps graphics pipeline libraries out of the pipeline cache, as before.")
SW(RX_VK_GPL_SYNC, kill, bool, "libraries asked without compiling in the draw (needs pipelineCreationCacheControl)", "Set, stage libraries are compiled in the draw itself, as before.")
SW(RX_VK_GPU_CLOCK, hw, enum, "peak clock held on the Steam Deck's APU (Linux, AMD); nothing done elsewhere", "0 leaves the driver's clocks; 1, peak or standard pick the GPU power state held while the game runs.")
SW(RX_VK_GPU_DUMP, diag, bool, "off", "In the statistics frame, also dumps the wanted programs' storage buffers as the GPU holds them after.")
SW(RX_VK_GPU_HANG_SEC, tune, int, "30 seconds", "Seconds of no GPU progress taken as a hang that ends the game; 0 only logs the stall.")
SW(RX_VK_GPU_PAGES, diag, bool, "off", "Notes the pages the GPU writes and counts mirror syncs that copy the CPU's version over them.")
SW(RX_VK_GPU_UNSWIZZLE, kill, bool, "on where the device has push descriptors", "=0 turns off unswizzling textures in a compute shader, leaving the CPU path.")
SW(RX_VK_GP_TEST, diag, int, "3: all of the global-pointer path (addressing model, page-table load, the loads and stores through it)", "Bisects the global memory pointer path: 1 the addressing model alone, 2 adds the table's load, 3 all of it.")
SW(RX_VK_HALF_RATE_SHADING, attempt, bool, "off: RADV_FORCE_VRS_CONFIG_FILE is dropped from the environment when it names an existing file", "=1 keeps RADV's forced-VRS variable so Steam's Half Rate Shading reaches the game.")
SW(RX_VK_HANDLES_LIVE, kill, bool, "off: handles read as the stream's place sees them (ub_read)", "=1 reads texture handles and storage words from the game's memory as it is now, as before.")
SW(RX_VK_HANDLE_POINTER, kill, bool, "texture handles that are storage-buffer pointer words are recognised", "1 turns off recognising a texture handle word as a storage pointer, treating it as a plain handle as before.")
SW(RX_VK_HANDLE_POINTER_ALL, kill, bool, "off: only fragment stages zero a texture handle that is a storage pointer", "Zeroes texture handles that are storage pointers in every stage, as before.")
SW(RX_VK_HANDLE_TABLES, kill, bool, "on where the GPU has non-uniform indexing and the descriptor limits (256 per stage, 512 per set), else off", "=0 turns off handle tables translated as descriptor arrays.")
SW(RX_VK_HANG_DUMP, diag, string, "no watchdog", "Writes every thread's stack to this file once no frame was shown for RX_VK_HANG_SEC seconds.")
SW(RX_VK_HANG_SEC, diag, int, "20 seconds (at least 5)", "Seconds without a frame before the hang dump is written.")
SW(RX_VK_HOLD_GPU_MS, tune, float, "1000 ms (never under RX_VK_HOLD_MS)", "Longest time stopped queues are held on for a thread waiting for the GPU.")
SW(RX_VK_HOLD_GPU_WAIT, kill, bool, "on", "=0 forces stopped queues on once RX_VK_HOLD_MS is past even while a game thread waits for the GPU.")
SW(RX_VK_HOLD_MS, tune, int, "50 ms", "How long a queue stopped at a wait is held before it is made to go on.")
SW(RX_VK_IGNORE_DISCARD, diag, bool, "off (rasterizer discard as the game asks)", "1 ignores the game's rasterizer-discard state, so discarded draws are rasterized.")
SW(RX_VK_IMAGES_VRAM_ONLY, kill, bool, "off: an image that does not fit in VRAM is made in system memory", "Refuses to make an image in system memory when VRAM is full; the image is left unmade.")
SW(RX_VK_IMAGE_BLOCK_MB, tune, int, "32 MB", "Sets the size of the image pools' memory blocks, 16 MB and up.")
SW(RX_VK_IMAGE_PREALLOC, hw, int, "15% of VRAM in blocks (2-24), 8% (2-12) under 8 GB, in the textures' pool; none on an integrated GPU", "Sets how many blocks the textures' pool makes at the start; 0 makes none.")
SW(RX_VK_IMMEDIATE, player, bool, "the menu's V-Sync row", "V-Sync Off (immediate) for one run, over the menu's V-Sync row.")
SW(RX_VK_IMPORT_CAP_MB, tune, int, "unset (-1): 4500 MB cap when the heap budget is 12 GB or more, the heap's own budget below", "Caps the budget the idle-import valve measures against, in MB; 0 turns the cap off at 12 GB and above.")
SW(RX_VK_IMPORT_CHUNK_MB, hw, int, "4 MB where pools have VRAM mirrors (discrete cards), 16 MB without", "The chunk size game memory is imported by, and so a pool mirror's least size; 0 imports by pool.")
SW(RX_VK_IMPORT_HIGH, hw, int, "85% on Linux and Windows NVIDIA; 0 (idle-import valve off) on Windows AMD/Intel; the retired valve always 85", "Percent of the system heap budget past which idle (and retired) imports of game memory are given back; 0 turns it off.")
SW(RX_VK_IMPORT_LOW, tune, int, "70% for the idle-import valve, 75% for the retired valve", "Percent of the system heap budget the import give-back valves bring usage down to.")
SW(RX_VK_IMPORT_SPAN_MB, tune, int, "64 MB", "Up to this size an import also takes the chunks of game pools that run across its ends; 0 does not.")
SW(RX_VK_INHERIT_ALL, kill, bool, "off: a new mirror inherits only the GPU-written parts of the old one", "A new mirror copies the whole overlapping part of the retired pool's mirror, as before.")
SW(RX_VK_INVALIDATE_WAIT, kill, bool, "off: the replay catches up only for ranges that may hold a GPU-written texture", "=1 catches the replay up for every invalidated range, as before.")
SW(RX_VK_IR, diag, string, "unset: nothing written", "Program key prefixes whose stages' Eden IR and SPIR-V are written to the working folder, plus compute info lines.")
SW(RX_VK_JOB_STEAL, kill, bool, "on: a waiting draw runs its still-queued job itself", "=0 makes a draw wait for a worker to reach its job behind the queue, as before.")
SW(RX_VK_KEEP_FINALIZED_MB, tune, int, "128 MB", "Sets how many MB of small finalized GPU-drawn textures are kept from eviction; 0 evicts them as before.")
SW(RX_VK_KEEP_MODULES, hw, bool, "Linux: modules kept above 20 GB of RAM with no shortfall, dropped otherwise", "Keeps the shader modules after the precompile whatever the RAM rule says.")
SW(RX_VK_KEEP_RENDERED_OVER, kill, bool, "off: rendered textures are kept a shorter time once near (97% of) the driver's allowance", "Shortens the keep time for rendered textures only once VRAM is past the driver's allowance, as before.")
SW(RX_VK_KEEP_RETIRED, hw, bool, "retired imports freed after a wait on Windows AMD/Intel, at once on Linux and Windows NVIDIA", "1 keeps retired pools' imports for the session, 0 gives them back as soon as the GPU is past them, on every OS and vendor.")
SW(RX_VK_LATE_DEFER, hw, bool, "follows RX_VK_READBACK_EARLY where pools have no mirror; always off with mirrors or parallel replay", "1 leaves a capture's late pages to the CPU reads that need them instead of waiting at the capture's take.")
SW(RX_VK_LATE_FIX, kill, bool, "on (off with RX_VK_PARALLEL above 1)", "0 makes a capture with late pages wait for the submission and copy them again, instead of the GPU fix pass.")
SW(RX_VK_LOAD, hw, enum, "create; start if an earlier session left the slow-loads marker, the host is version 14 or older, or the cac...", "create loads programs when the game makes them, start loads every listed program before the title.")
SW(RX_VK_LOAD_ALL_VARIANTS, attempt, bool, "off: a compute program's variants are read without their code at its first pick", "Reads every variant of a program whole from the program cache at its first pick.")
SW(RX_VK_LOAD_UNLISTED, attempt, bool, "off: only programs a note names are loaded at create", "Also loads at create the kept programs that no list names.")
SW(RX_VK_LOAD_WORKERS, tune, int, "2", "How many worker threads load programs and pipelines during play (0 to 16; 0 = none, a measurement).")
SW(RX_VK_LOAD_WORKERS_LOADING, tune, int, "the same as RX_VK_LOAD_WORKERS (2)", "How many load workers run while the game is taken to be loading (at least RX_VK_LOAD_WORKERS, at most 16).")
SW(RX_VK_LOG_ADDR, diag, bool, "no logging", "Logs the GPU address range of each imported pool, dma-buf and mirror, to place a device fault's address.")
SW(RX_VK_LOG_B2T, diag, bool, "no logging", "Logs the first 60 buffer copies into textures 960 wide or more, and in the host who recorded them.")
SW(RX_VK_LOG_BAKED, diag, bool, "no logging", "Logs, every 600 presents, the textures drawn in a single frame by size bucket and the ten largest.")
SW(RX_VK_LOG_BIG_COPY, diag, bool, "no logging", "Logs up to 300 copies into textures of 32 MB or more.")
SW(RX_VK_LOG_BRX, diag, bool, "off: no line", "Prints a stderr line for each constant-buffer-bounded indirect branch table the shader translator finds.")
SW(RX_VK_LOG_CASCADE_BIAS, diag, bool, "off", "Logs the depth bias the game asks for on shadow cascades, 40 lines.")
SW(RX_VK_LOG_COPY, diag, bool, "no logging", "Logs the first 400 texture-to-texture copies.")
SW(RX_VK_LOG_CS, diag, bool, "off", "Logs each compute program's control bytes in hex with its binding counts.")
SW(RX_VK_LOG_DEFERRED, diag, bool, "off", "=1 logs compute's deferred binds as at the submit and as the game's array holds them now, 400 lines.")
SW(RX_VK_LOG_DRAWS, diag, bool, "off", "1 logs each draw.")
SW(RX_VK_LOG_EARLY_CHECK, diag, int, "0: no read is checked", "<n> checks one early-released read in n against what the full wait would have read.")
SW(RX_VK_LOG_HITS, diag, bool, "off", "1 logs counts of texture view lookups (hits, new, re-registered, destroyed) every 200000 bindings.")
SW(RX_VK_LOG_IMG, diag, string, "nothing logged", "A list of program key prefixes whose texture and image bindings are logged, 8 times each.")
SW(RX_VK_LOG_INVALIDATE, diag, bool, "off", "=1 logs 400 invalidates with the GPU-written textures in their range.")
SW(RX_VK_LOG_LIVE, diag, bool, "no logging", "Logs why dirty pages were synced from live guest memory rather than a capture (up to 300 sampled lines).")
SW(RX_VK_LOG_MADE, diag, int, "no logging", "Logs up to 300 textures made from the given frame number on, with their shape and other images at the same address.")
SW(RX_VK_LOG_MESH_BINDS, diag, bool, "off", "=1 logs the buffers the game binds to the task and mesh stages, up to 300 lines a site.")
SW(RX_VK_LOG_MESH_DRAWS, diag, bool, "off", "Logs how large each mesh draw is when it is the largest so far, 400 lines.")
SW(RX_VK_LOG_MESH_INDIRECT, diag, bool, "off", "Logs what indirect mesh draws hold (300 lines) and the counts the GPU copied.")
SW(RX_VK_LOG_MESH_PERPROG, diag, bool, "off", "Logs per mesh program the counts and firsts the GPU wrote, 40 windows.")
SW(RX_VK_LOG_MESH_PROGS, diag, bool, "off", "Logs each mesh program's first draw and every 600th with its indirect arguments.")
SW(RX_VK_LOG_PARTIAL, diag, bool, "no logging", "Logs up to 200 partial texture uploads with their dirty ranges.")
SW(RX_VK_LOG_PROGRAM_LIFE, diag, bool, "off", "Logs a line at each program made or freed and at each program's first draw or dispatch.")
SW(RX_VK_LOG_PUSH, diag, string, "nothing logged", "Logs once the push constants and c0 words of the compute program whose key has this prefix.")
SW(RX_VK_LOG_RB_WRITERS, diag, enum, "off", "1 logs what wrote the pages a readback waits for; 2 is the probe-only form.")
SW(RX_VK_LOG_READBACK, diag, int, "unset: nothing logged", "<present> logs 300 invalidates from that present on: fence, completed value, the first words read.")
SW(RX_VK_LOG_READBACK_RANGES, diag, enum, "off", "1 logs the readbacks by range every 3000 calls, costliest first; 2 sorts the largest first.")
SW(RX_VK_LOG_READBACK_WAITS, diag, bool, "off", "=1 logs each readback that waited: how long, its value, its part's and submission's recordings.")
SW(RX_VK_LOG_READ_TEXELS, diag, bool, "off", "=1 logs 200 CPU texture readbacks and whether the GPU wrote the texture.")
SW(RX_VK_LOG_REMADE, diag, bool, "off: no lines", "Logs textures made again after the budget evicted them, and how many frames later.")
SW(RX_VK_LOG_REMAP, diag, bool, "off: no lines", "Logs where a big texture's remapped pages now point and what images are there, up to 120 lines.")
SW(RX_VK_LOG_RESTART, diag, bool, "off", "Logs the primitive restarts draws ask for, by topology, index type and restart index.")
SW(RX_VK_LOG_STAMP, diag, string, "no logging", "<lo>:<hi> hex guest addresses: logs up to 300 memory stamps in that range with their callers.")
SW(RX_VK_LOG_SWIZZLE, diag, bool, "no logging", "Logs the swizzle of the first 12 sampled views of RGB9E5 textures.")
SW(RX_VK_LOG_TABLE, diag, bool, "off: table-entry bound/unbound flips are logged 60 lines, then tracking stops", "Keeps logging storage table entries that are bound one frame and not the next, without the limit.")
SW(RX_VK_LOG_TINY_FLUSH, diag, bool, "no logging", "Logs the values of up to 400 tiny (64 bytes or less) texture write-backs, such as a 1x1 luminance.")
SW(RX_VK_LOG_UPLOADS, diag, int, "unset: no lines", "Present number from which texture uploads are logged, 200 of them.")
SW(RX_VK_LOG_VMAP_CHANGING, diag, bool, "off: no lines", "Logs each vmap_changing call (pages about to be unmapped or remapped), up to 300 lines.")
SW(RX_VK_LOG_WB_SKIPS, diag, bool, "no logging", "Logs the written bindings left out of the write-back, by guest range, every 600 submits.")
SW(RX_VK_LOG_WRITEBACK, diag, bool, "off", "Logs programs binding written storage buffers of 8 MB or more, and the pools written back the most.")
SW(RX_VK_LOG_WRITTEN, diag, bool, "off", "Logs every storage buffer range a program writes, once each, 300 at most.")
SW(RX_VK_LOWER_SKIP, diag, string, "empty: none skipped", "Comma list of program key prefixes left unlowered, as if they did not lower, for a bisection.")
SW(RX_VK_LOW_SPEC, attempt, bool, "off", "Opt-in low-VRAM profile: first run starts on preset 1 without upscale filter, no staging blocks kept, no capture copy helpers.")
SW(RX_VK_LOW_VRAM_MIPS, hw, bool, "on at Minimum's settings when the driver allows 4.5 GiB or less, or on an integrated GPU with 16 GB of RAM...", "=0 turns off the smaller texture limits (1024 wide, 8 MB) used on low-VRAM PCs at Minimum.")
SW(RX_VK_MALLOC_TRIM_MB, tune, int, "192 MB free in the heap (64 while Linux memory pressure is on)", "Sets how many MB of free malloc arena memory trigger a malloc_trim on a worker; 0 never trims.")
SW(RX_VK_MARKERS_V205, attempt, bool, "off: markers avoid the registers the current lowering reserves", "Lowering picks marker registers as v2.0.5 did, avoiding only the native high registers: an A/B for the AMD stripes report.")
SW(RX_VK_MASK_BLEND, attempt, float, "0: off", "Blends a mask with its history at that weight (0-0.95) to stabilise streaks.")
SW(RX_VK_MASK_RADIUS, tune, int, "0: unbounded history", "Bounds the mask history to a (2r+1)^2 neighbourhood, r from 0 to 4.")
SW(RX_VK_MENU_SCRIPT, diag, string, "no script", "Plays timed Insert menu key presses (<seconds>:<key>,...) for automated runs.")
SW(RX_VK_MESH_ARGS, attempt, bool, "off", "Rewrites indirect mesh draw arguments as {count,1,1,first} outside the pass, replacing the conversion.")
SW(RX_VK_MESH_COUNT_WORD, tune, int, "0", "Picks which word of an indirect mesh record is copied as the count in the RX_VK_MESH_ARGS rewrite.")
SW(RX_VK_MESH_FB_LAYOUT, kill, enum, "soa (records line after line)", "aos stores the compute mesh fallback's vertex records one after another instead of line by line.")
SW(RX_VK_MESH_FIRST, attempt, bool, "off: task programs do not read the draw's first workgroup", "Native task programs read the draw's first task workgroup through a pushed address (with RX_VK_MESH_ARGS=1).")
SW(RX_VK_MESH_FIRST_WORD, tune, int, "1", "Picks which word of an indirect mesh record is copied as the first in the RX_VK_MESH_ARGS rewrite.")
SW(RX_VK_MESH_IND_COUNT_WORD, tune, int, "0", "Picks which word (0-3) of an indirect mesh record holds the count for the conversion.")
SW(RX_VK_MESH_IND_RAW, kill, bool, "off: indirect mesh draws' records are converted to {count,1,1}", "Skips the conversion of indirect mesh draw arguments and uses them raw.")
SW(RX_VK_MESH_NOCULL, attempt, string, "empty: culling kept in every task shader", "Comma list of code key prefixes whose task shaders have their culling turned off, so every meshlet is drawn.")
SW(RX_VK_MESH_NO_DEFAULTS, kill, bool, "off: unwritten components of a mesh program's generic outputs get defaults (0, and 1 for .w)", "Leaves unwritten components of mesh programs' generic outputs undefined, as before the fix.")
SW(RX_VK_MESH_NO_ZERO, kill, bool, "off: the mesh stage buffer's map and attribute regions are zeroed first", "Skips zeroing the mesh stage buffer's map and attribute regions, as before the fix.")
SW(RX_VK_MESH_OPT, hw, bool, "task/mesh programs built without the driver's optimizer on AMD cards unless the driver is RADV; with it els...", "1 builds task and mesh programs with the driver's optimizer on AMD too.")
SW(RX_VK_MESH_SHADERS, hw, enum, "Automatic: native mesh shaders where the GPU has them, compute fallback where not (and per-GPU rules)", "native or compute forces how the game's task and mesh programs run; any other value is Automatic.")
SW(RX_VK_MET_WAIT_CAPTURE, kill, bool, "on (unless RX_VK_RESUME_CAPTURE=0 or the render thread RX_VK_ASYNC is on)", "=0 turns off the capture taken when a queue goes on from a wait a CPU signal met.")
SW(RX_VK_MIRROR, hw, bool, "on for discrete GPUs, off for integrated ones", "0 turns off the VRAM mirrors of the game's buffer pools; 1 forces them on.")
SW(RX_VK_MIRROR_DEFER, kill, bool, "off: a pool's mirror is made at its first binding", "1 makes a pool's mirror at the next submission rather than at its first binding, as before.")
SW(RX_VK_MIRROR_KEEP, kill, bool, "off: idle pools' VRAM mirrors are given back", "Keeps every pool's VRAM mirror instead of giving idle ones back (the older behaviour, for A/B).")
SW(RX_VK_MIRROR_MB, hw, int, "by VRAM: min(1700 MB, a third) on cards of 6.5 GB or less, else mirror_budget.h's rule (a quarter, 2-3 GB cap)", "Sets the VRAM mirrors' budget in MB.")
SW(RX_VK_MIRROR_SPARSE, kill, bool, "on where the device has strict sparse residency for buffers; whole mirrors elsewhere", "0 goes back to whole VRAM mirrors instead of sparse ones with memory only where a game pool is.")
SW(RX_VK_MIRROR_TIGHT, attempt, bool, "off", "Refuses new pool mirrors (and trims) while VRAM is over 90% full.")
SW(RX_VK_MIRROR_TRIM, kill, bool, "on", "=0 stops imports whose mirror is mostly outside live game pools being remade smaller under VRAM pressure.")
SW(RX_VK_MISS_LOG, diag, bool, "off: no miss buffer, no section in the frame log", "Compute programs record global memory addresses no binding held in a buffer at c0+0xff0, listed in the frame log.")
SW(RX_VK_MISS_LOG_PROG, diag, string, "unset: the miss log covers every program", "Key prefix that limits the NVN2 miss log (and RX_VK_DUMP_SPV) to that one program.")
SW(RX_VK_MMA_A_ORDER, diag, string, "the element order measured on the GPU at start-up", "Gives matrix A's cooperative-matrix element order as a comma list instead of the measured one, and skips the layout test.")
SW(RX_VK_MMA_B_ORDER, diag, string, "the element order measured on the GPU at start-up", "Gives matrix B's cooperative-matrix element order as a comma list instead of the measured one, and skips the layout test.")
SW(RX_VK_MMA_C_ORDER, diag, string, "the element order measured on the GPU at start-up", "Gives matrix C's cooperative-matrix element order as a comma list instead of the measured one, and skips the layout test.")
SW(RX_VK_MMA_NO_COOP, attempt, bool, "off (cooperative matrices used when the device has them)", "1 pretends the device has no cooperative matrices, so the software multiplies are used.")
SW(RX_VK_MMA_NO_LDSM_BARRIER, kill, bool, "off: a subgroup barrier before and after each LDSM's reads", "Drops the subgroup barriers around LDSM shared-memory reads in the upscale networks, as before the fix.")
SW(RX_VK_MMA_SOFTWARE, attempt, bool, "off (native cooperative matrices where the device has and passes them)", "1 forces the upscale networks' matrix multiplies into a software shader function, with no cooperative matrices.")
SW(RX_VK_MMA_UNROLL, hw, bool, "on for Mesa RADV, off (the loop) elsewhere; only where matrix multiplies run in software", "0 keeps the looped software matrix multiply, 1 tries the unrolled forms on any GPU.")
SW(RX_VK_MODULE_IDS, kill, bool, "on", "=0 turns off shader module identifiers (VK_EXT_shader_module_identifier) for loading compute programs.")
SW(RX_VK_MOVIE_BLIT, kill, bool, "off: the movie's linear upscale runs in a compute shader", "Turns off the shader movie upscale so the blit is tried instead, as before.")
SW(RX_VK_MOVIE_UPSCALE, attempt, enum, "automatic: movie networks are replaced by a linear upscale only where they cannot run or measure too slow", "=linear always replaces the movie upscaler networks with a linear upscale; anything else is automatic.")
SW(RX_VK_NAN_BITS, hw, bool, "on for AMD's proprietary driver whose driverInfo names the 'proprietary shader compiler' (RDNA 1 and 2 on W...", "Forces isnan as a test of the value's bits rather than OpIsNan off (0) or on (non-zero), whatever the driver.")
SW(RX_VK_NAN_GUARD, kill, bool, "on (NaN guard on float colour outputs, every card)", "0 turns off the NaN guard on fragment colour outputs, both the emitter's and GuardFragmentOutputs.")
SW(RX_VK_NATIVE_FADD, hw, bool, "on for NVIDIA's driver and Intel's Windows driver on Meteor/Arrow/Panther Lake and Arc B-series; off elsewhere", "1 uses the GPU's own atomic float add in shaders where it has it; 0 keeps the compare-exchange loop on every GPU.")
SW(RX_VK_NATIVE_MMA, kill, bool, "on where the device's cooperative matrices pass the self-test (else software)", "0 turns native matrix multiplies off, keeping the translator's expansion.")
SW(RX_VK_NATIVE_MMA_KEYS, kill, string, "'all': every compute program uses the host's cooperative matrices where the GPU has them", "Key prefixes of the compute programs that keep native matrix multiplies; the others take the exact expansion.")
SW(RX_VK_NETWORK_KEEP, kill, string, "fd029a317a9a4b94,9dc98871eb7fc101: only the two gameplay networks kept where networks are left out", "Lists the upscaler network programs (key prefixes) that still run; all keeps every one, slow movies too.")
SW(RX_VK_NOCULL, diag, bool, "off (face culling as the game asks)", "1 draws with no face culling, a debug picture.")
SW(RX_VK_NODEPTH, diag, bool, "off (depth test and write as the game asks)", "1 draws everything without depth test or depth write, a debug picture.")
SW(RX_VK_NOOPT, attempt, bool, "off (driver optimizer on, but for AMD task/mesh programs and the mesh fallback)", "1 builds every pipeline in play without the driver's optimizer.")
SW(RX_VK_NO_A2C, kill, bool, "alpha-to-coverage as the game asks", "1 turns alpha-to-coverage off for every draw (the foliage's).")
SW(RX_VK_NO_CBUF_LOAD_RULE, kill, bool, "off: the rule is on (such an address is left to the run-time search)", "Turns off the rule that leaves a graphics stage's memory-derived address in a non-c0 constant buffer to the run-time search.")
SW(RX_VK_NO_DISPATCH_ORDER, kill, bool, "off: a dispatch after other work gets a full barrier first", "Leaves out the full barrier that orders a dispatch after the work before it.")
SW(RX_VK_NO_DMABUF, kill, bool, "Linux, non-NVIDIA: guest memory imported as dma-bufs where udmabuf works; host pointers elsewhere", "Imports guest memory by host pointers only, never as dma-bufs.")
SW(RX_VK_NO_DRAWN_PAGE_MAP, kill, bool, "off: a virtual-pool texture's page mapping is noted when the GPU first writes it", "Stops noting a virtual-pool texture's page map at its first GPU write, as before.")
SW(RX_VK_NO_DRAWN_WRITEBACK, kill, bool, "off: drawn textures are written back to guest memory a frame later, without waiting", "Turns off the deferred write-back of GPU-drawn textures into guest memory, as before.")
SW(RX_VK_NO_DRAW_PARAMS, kill, bool, "off: vertex stages read base vertex, base instance and draw index from Vulkan", "=1 leaves the draw's base vertex, base instance and draw index as zeros in the driver bank, as before.")
SW(RX_VK_NO_DRY_CLEARS, kill, bool, "off: the parallel replay's dry pass marks a clear's targets", "=1 stops the dry pass from marking the targets of clears, as before.")
SW(RX_VK_NO_DRY_MARKS, kill, bool, "off: dry passes mark the targets later segments will write", "Turns off the dry pass's written-target marks, as before.")
SW(RX_VK_NO_DRY_SHORT, kill, bool, "off: submissions under two segments are recorded directly", "=1 runs the dry pass and one segment even for a short submission, as before.")
SW(RX_VK_NO_EVICT, kill, bool, "off: textures are evicted to stay within the budget", "Evicts no textures at all, and stops the dead-target sweeps too (an experiment).")
SW(RX_VK_NO_EXTREGS, kill, bool, "off: native programs that use the extended (high) registers are lowered", "Rejects native programs that use the lowering's scratch (high) registers, as before extended registers were handled.")
SW(RX_VK_NO_F16, kill, bool, "off: f16 shader math used where the GPU has shaderFloat16", "=1 lowers the game's f16 math to f32 as on a GPU without f16 shaders, and leaves the upscaler networks out.")
SW(RX_VK_NO_FOLLOW, kill, bool, "on: compute shaders follow guest pointers through the page table", "Turns off following loaded pointers through the guest page table in shaders; no page table buffer is made.")
SW(RX_VK_NO_GRID_PATCH, kill, bool, "off: indirect dispatches get the grid patch", "Turns off the grid patch applied while building descriptors for indirect dispatches.")
SW(RX_VK_NO_IMAGE_POOL, kill, bool, "off: images are allocated from the pools", "Allocates images without any of the image pools, leaving the choice to VMA.")
SW(RX_VK_NO_INHERIT, kill, bool, "off: a remade pool's mirror inherits the old mirror's GPU-written data", "1 fills a remade pool's new mirror from guest memory only, as before.")
SW(RX_VK_NO_INTEL_SERIAL, player, bool, "the Intel shader compiles row (Auto: side by side on Arc B-series from driver 101.9154, one at a time on ot...", "1 lets Intel's shader compiler be entered side by side, 0 one at a time, over the menu row, which it fixes.")
SW(RX_VK_NO_INVARIANT, hw, bool, "positions invariant on every card but NVIDIA; off on NVIDIA", "1 turns off the invariant decoration on vertex positions where it is on (non-NVIDIA cards).")
SW(RX_VK_NO_MESH, diag, enum, "0: every draw runs", "1 leaves out task/mesh draws, 2 leaves out all the others, to see what each draws.")
SW(RX_VK_NO_MESH_FALLBACK, kill, bool, "compute fallback used where the GPU has no mesh shaders (and for task+mesh draws where that rule is on)", "Turns off the compute fallback for task and mesh programs, both the no-mesh-shader one and the task+mesh one.")
SW(RX_VK_NO_MESH_WARNING, kill, bool, "warning shown once on a GPU with no mesh shaders and no fallback", "Suppresses the log line and message that the GPU has no mesh shaders and cannot draw foliage and effects.")
SW(RX_VK_NO_PARTIAL, kill, bool, "off: only the dirty ranges of an uploaded texture are uploaded again", "Uploads a changed texture whole instead of only its dirty ranges (an A/B switch).")
SW(RX_VK_NO_PASS_HAZARDS, kill, bool, "off: read/write hazards inside an open pass are checked", "Turns off the check for draws that sample what the open pass writes.")
SW(RX_VK_NO_PREDICT, kill, bool, "off: predict_run builds the predicted pipelines when it is called", "Skips building the predicted pipelines in the preparation and removes its pending marker.")
SW(RX_VK_NO_PREDICT_CHECK, kill, bool, "off: the start after a preparation samples the driver's cache and logs it", "Skips the logged background sample of predicted pipelines asked of the driver's cache.")
SW(RX_VK_NO_PRESYNC, kill, bool, "off: mirrors are synced once before a command buffer's parallel segments", "Skips the mirror pre-sync before parallel segments, as before.")
SW(RX_VK_NO_PROGRAM_CACHE, kill, bool, "program cache and pipeline notes read and written", "1 neither reads nor writes hookshot_programs.bin and the pipeline and compute notes.")
SW(RX_VK_NO_RB_REFRESH, kill, bool, "off: small readback pages are refreshed from guest memory into the mirror each submission", "Turns off the refresh of small CPU-read result pages (meters, counters) into the mirror.")
SW(RX_VK_NO_READBACK_WAIT, kill, bool, "off: a CPU read of GPU results waits for the submission that writes them back", "Stops CPU reads of GPU results from waiting for their write-back, and stops noting written-back pages.")
SW(RX_VK_NO_STATE_LIST, kill, bool, "pipeline state list recorded and prepared from", "1 turns off recording pipeline states to the state list and preparing pipelines from it.")
SW(RX_VK_NO_SUBGROUP_PIN, kill, bool, "subgroup size pinned to 32 where the device supports size control", "Stops pinning shader stages to a subgroup size of 32.")
SW(RX_VK_NO_TABLE_SHRINK, kill, bool, "off: a table entry that does not fit its pool is bound smaller, down to 1 MB", "Leaves a storage table entry that does not fit its pool unbound, as before.")
SW(RX_VK_NO_UPSCALE_STUB, kill, bool, "off: a left-out or failed upscaler network's last pass becomes a linear upscale", "Turns off the linear-upscale stand-in for left-out upscaler networks, as before.")
SW(RX_VK_NO_VMAP_FLUSH, kill, bool, "off: flushable GPU-written textures of virtual pools are listed for write-back", "Stops listing GPU-written textures of virtual pools for flushing back into guest memory.")
SW(RX_VK_NO_WARM, kill, bool, "off: the preparation warms the driver's cache (stage libraries where GPL is wanted, and computes)", "Leaves the driver-cache warm pass out of the shader preparation.")
SW(RX_VK_NO_WRITEBACK, attempt, bool, "off: GPU writes are copied back to guest memory", "GPU writes to mirrored pools are not copied back to guest memory (an experiment, for A/B).")
SW(RX_VK_OCC_COPY, hw, bool, "on for Intel discrete cards on Intel's Windows driver, off elsewhere; always off with parallel replay", "1 copies occlusion results to a host buffer on any GPU, 0 reads them from the query pool.")
SW(RX_VK_OCC_DRY, diag, bool, "off", "Occlusion queries are made and read but the reports are left at 4096, to time the queries alone.")
SW(RX_VK_OCC_FIXED, attempt, int, "unset: real queries; the fallback fixed value is 4096", "Every samples-passed report reads this fixed value and real queries are off; -1 uses the per-draw count.")
SW(RX_VK_OCC_LOG, diag, bool, "off", "Logs occlusion query statistics about every 5,000 reports.")
SW(RX_VK_OCC_QUERIES, kill, int, "on (1) where the device can reset queries from the CPU", "=0 turns real occlusion queries off (every report reads 4096); =2 also counts runs with colour draws.")
SW(RX_VK_PACE, player, bool, "the Frame pacing row", "Turns frame pacing on or off for one run, over the Frame pacing row.")
SW(RX_VK_PARALLEL, attempt, int, "0: off, the replay records on one thread", "Number of threads (2-8) that record a command buffer's segments in parallel; 0 or 1 is off.")
SW(RX_VK_PARALLEL_SEG, tune, int, "160 draws and dispatches (minimum 32)", "Size of the segments a parallel replay splits a submission into.")
SW(RX_VK_PASS_BARRIER, attempt, enum, "every draw pass starts with a full barrier", "=game makes a draw pass right after another, with no game barrier between, wait in its fragment stages only.")
SW(RX_VK_PASS_TIMING, diag, int, "off: no GPU timestamps", "Times each pass on the GPU with timestamps and logs it every 600 presents; the value is the detail level.")
SW(RX_VK_PASS_TRACE, diag, bool, "off", "Records the passes and dispatches of the last frames and logs them around a flash or dark frame.")
SW(RX_VK_PASS_TRACE_AT, diag, int, "0: off", "<n> logs the passes of the frame at every nth present.")
SW(RX_VK_PCACHE_FETCH_LOCK, hw, bool, "on for Intel on Windows, off elsewhere (off on Linux)", "1/0 forces on or off fetching pipeline cache data only while no pipeline build uses a cache.")
SW(RX_VK_PCACHE_LOAD, hw, bool, "read, except on Linux with NVIDIA's driver, 20 GB of RAM or less and NVIDIA's own shader cache on and warm...", "0 never reads or saves the pipeline cache file and its play files; 1 reads it whatever the automatic rule says.")
SW(RX_VK_PCACHE_STAMP, kill, bool, "on (pipeline cache files dropped at start when another translator made them)", "0 keeps hookshot_vk_pipelines.bin and its play files whatever translator made them.")
SW(RX_VK_PEEK_PROG, diag, string, "unset: nothing logged", "Logs the first words of the storage buffers of programs matching a key prefix, 60 lines.")
SW(RX_VK_PERF_INTERVAL, tune, int, "300 s between summaries", "Seconds of play between two performance summaries (60 to 840) while Send performance statistics is on.")
SW(RX_VK_PER_QUEUE_FENCES, kill, bool, "on: a fence waits for its own queue's work", "=0 makes a fence wait for every queue's work up to it, stopped work forced on, as before.")
SW(RX_VK_PGO_FILE, diag, string, "no profile written (and read only by a renderer built with RX_VK_PGO=gen)", "In a counting (RX_VK_PGO=gen) renderer, names the file its branch counters are written to; <file>.reset clears them.")
SW(RX_VK_PICK_BIND_GEN, kill, bool, "off: the last picks stand while the textures their answers read from do", "=1 drops the fast program pick whenever anything at all was bound anew, as before.")
SW(RX_VK_PIPE_SKIP, kill, enum, "1: translation is waited for; a pending pipeline is skipped only for draws that write no memory on earlier...", "0 always waits for pipelines too; 2 restores the old skip of untranslated draws on persistent targets.")
SW(RX_VK_PIPE_WAIT_MS, attempt, float, "off (0: no wait)", "Milliseconds a frame a draw on earlier frames' targets may wait for its pipeline, moved to the queue's front.")
SW(RX_VK_PLAY_ASK_START_FIRST, kill, bool, "on (library pipelines asked of the start cache first)", "0 asks the play generation first for the stage libraries too, as before.")
SW(RX_VK_PLAY_CACHE, kill, bool, "on (what play makes goes into play cache files; needs pipelineCreationCacheControl)", "0 puts every pipeline play makes into the one pipeline cache, as before the play generations.")
SW(RX_VK_PLAY_SAVE_START_MB, tune, int, "64 MB (0: any growth, as before)", "Growth of the start's pipeline cache past which it is written again in play.")
SW(RX_VK_POOL_END_IMPORTED, kill, bool, "off: a pool's start and end are the game pool's", "1 answers a pool's start and end from the import's range rather than the game pool's, as before.")
SW(RX_VK_POOL_IDLE, tune, int, "8 presents (target_pool::kIdlePresents)", "How many presents a pooled render target may wait unused before it is destroyed.")
SW(RX_VK_PRECOMPILE, kill, bool, "on in HOOKSHOT_RELEASE builds (the builders'), off in development builds", "Turns the shader preparation before the title off (0) or on (1).")
SW(RX_VK_PRECOMPILE_COMPUTES, tune, enum, "the computes play dispatched plus the shipped list's; every kept one on a first start", "Which compute programs the preparation builds: all, listed, learned or none.")
SW(RX_VK_PRECOMPILE_SAVE_S, tune, int, "30 seconds (0: never)", "Build time of the noted pipelines past which the pipeline cache is written before the title.")
SW(RX_VK_PRECOMPILE_STALL_S, tune, int, "30 seconds", "Seconds without progress after which the precompile goes on without the pipelines still in the driver.")
SW(RX_VK_PREDICT_S, tune, int, "0: no time budget, every predicted pipeline is built", "Stops building the predicted pipelines after this many seconds; the rest are built in play.")
SW(RX_VK_PREDICT_STALL_S, tune, int, "30 seconds (0: wait for all)", "Seconds without progress after which the prediction leaves the last stragglers to play.")
SW(RX_VK_PREFETCH_CHUNKS, attempt, int, "0: off", "How many neighbouring chunks on each side of an on-demand import are imported ahead in the background.")
SW(RX_VK_PREPARE_AGAIN, diag, bool, "off: a preparation the record says is done is not repeated", "Runs the shader preparation again although the record says it is current.")
SW(RX_VK_PREPARE_BACKGROUND, attempt, bool, "off: after an update the whole preparation runs before the game", "After an update, builds only what the notes name before the game and the rest behind play.")
SW(RX_VK_PREPARE_STALL_S, tune, int, "300 seconds", "Seconds with nothing moving before a prepare run gives up on a stuck driver and exits with status 4; 0 never stops.")
SW(RX_VK_PREPARE_STATUS_S, tune, int, "30 seconds", "Seconds of silence before the prepare watchdog prints a status line (at least 1).")
SW(RX_VK_PRESENTS_AHEAD, tune, int, "1 (clamped 1-8)", "How many presents the game may hand over ahead of the render thread.")
SW(RX_VK_PRESENT_AFTER_SIGNAL, kill, bool, "follows the frame gate: on with the render thread unless RX_VK_FRAME_GATE=0", "0 or 1 forces off or on the present waiting for the CPU signal its frame's work waits for.")
SW(RX_VK_PRESENT_AHEAD, kill, bool, "on: a frame generation set's copies are submitted together", "=0 submits each frame generation copy at its own time, as before #1702.")
SW(RX_VK_PRESENT_LOG, diag, bool, "off", "=1 traces the present's geometry: source, content, output and destination rectangle.")
SW(RX_VK_PRESENT_QUEUE, attempt, bool, "off on every PC", "1 makes presents on a compute family's queue of their own, beside the replay's queue.")
SW(RX_VK_PRESENT_THREAD, attempt, bool, "off on every PC: presents on the game's thread (only the spare queue is reserved by default on NVIDIA)", "1 makes each present on a presenter thread with a queue of its own; 0 or unset keeps presents on the game's thread.")
SW(RX_VK_PROBE, diag, enum, "unset: off", "Reads the centre texel after every pass into probe files: 1 at a flash (serial replay), 2 at speed.")
SW(RX_VK_PROBE_MIN, diag, int, "384 pixels", "Sets the smallest image width RX_VK_PROBE=2 probes.")
SW(RX_VK_PROBE_UBO, diag, string, "unset: no uniform buffers probed at speed", "With RX_VK_PROBE=2, probes the uniform buffers of programs matching the key prefixes.")
SW(RX_VK_PROBE_UBO_HEX, diag, bool, "off", "Adds the probed uniform buffers' words in hex to the probe output.")
SW(RX_VK_PROF_ALL, diag, bool, "off: one draw in eight is timed", "Times every profiling scope instead of sampling, making the phase breakdown exact.")
SW(RX_VK_PROF_FINE, diag, bool, "off", "1 times the draw path's sections and counts what each draw does, finer than the frame line's phases.")
SW(RX_VK_PROGRAM_CACHE_ZSTD, attempt, bool, "off", "Stores program cache records zstd-compressed in a separate file (hookshot_programs.zst.bin).")
SW(RX_VK_PROTECT_BARE, attempt, bool, "off", "1 keeps the GPU's version of pages a shader writes through a bare table pointer when the CPU also wrote them.")
SW(RX_VK_PSYCHOV35_DLSS, kill, bool, "on: compatible engines take Native PsychoV35's RGBA16F scene", "=0 disables the Native PsychoV35 HDR route for the upscalers, for troubleshooting.")
SW(RX_VK_PTR_DIAG, diag, bool, "off: no lines", "Logs a line for each program whose global memory accesses are not all plain constant buffer pointers.")
SW(RX_VK_PTR_SPLIT_FALLBACK, kill, bool, "on: a split address is left to the run-time search", "=0 binds a split address to the constant buffer pointer on one side of its select or phi, as before.")
SW(RX_VK_PUSH_ALL, kill, bool, "off: only changed bindings are pushed", "Pushes every descriptor binding at every draw, as before.")
SW(RX_VK_PUSH_STATE_OLD, kill, bool, "off: the new pushed-state comparison", "Tracks pushed descriptor state as a vector of words per write, as before.")
SW(RX_VK_QUEUE_STATE, kill, bool, "on: each queue keeps its own replay state", "=0: one replay state shared by all queues, as before.")
SW(RX_VK_QUICK_MS, attempt, float, "off (0: no quick pipelines)", "Milliseconds a frame each recording thread may spend on quick pipeline builds for draws still waiting.")
SW(RX_VK_RB_REFRESH_EACH, kill, bool, "off: a recording that joined an open submission refreshes only pages safe to copy", "1 refreshes the readback pages in every recording, as before.")
SW(RX_VK_REACTIVE, attempt, bool, "off", "Builds a reactive mask for DLSS and FSR 3.1 from the scene's blended draws.")
SW(RX_VK_REACTIVE_DEBUG, diag, bool, "off", "Shows the reactive mask as a debug picture.")
SW(RX_VK_REACTIVE_MAX, tune, float, "0.9", "Upper limit of the reactive mask's values (0 to 1).")
SW(RX_VK_REACTIVE_SCALE, tune, float, "1.0", "Scale applied to the reactive mask's values (0 to 64).")
SW(RX_VK_READBACK_EARLY, hw, bool, "on without VRAM mirrors (non-discrete GPUs) unless parallel replay or the render thread is on; else off", "1 lets a CPU read of GPU results written in place wait only for its writer's part; 0 waits for the whole submission.")
SW(RX_VK_READBACK_EARLY_GAP, tune, int, "16 draws", "Fewest draws into a part before a readback writer may end it early (RX_VK_READBACK_EARLY).")
SW(RX_VK_READBACK_EARLY_RECORDED, kill, bool, "on: an early read waits (up to 250 ms) until its writer's submission is recorded", "=0 lets an early read go while its writer's submission is still being recorded, as before.")
SW(RX_VK_READBACK_EXACT, attempt, enum, "0: off", "1 reads every range after all handed-over work is replayed; 2 only ranges over 16 KiB (a test).")
SW(RX_VK_READBACK_LATE, attempt, string, "unset: every readback waits for its write-back", "A list of rules (newest, sizes) naming readbacks read without their wait, a frame late.")
SW(RX_VK_READBACK_NO_CATCHUP, attempt, bool, "off: a readback catches the replay up or settles first", "=1 (A/B) skips the catch-up before a readback: recorded work only.")
SW(RX_VK_READBACK_OFF_FILE, diag, string, "unset: invalidate always writes GPU-written texels back", "<path>: while that file exists invalidate skips its texture write-back and catch-up (a live A/B).")
SW(RX_VK_READBACK_PART, kill, bool, "on: a readback waits for the part that writes its range", "=0 makes a readback wait for its submission's last part always, as before.")
SW(RX_VK_READBACK_SETTLE_ALWAYS, kill, bool, "off: a readback settles stopped queues only after a new CPU signal", "=1 makes every readback look at the stopped queues whenever anything is stopped, as before.")
SW(RX_VK_READBACK_WAIT_MS, tune, int, "250 ms", "Longest a readback waits for its write-back's value before reading what memory holds; 0 is no limit.")
SW(RX_VK_RECORDER, player, enum, "the Threaded rendering row: thread where it resolves on, else off", "Chooses the command recorder for the run (sync, defer, thread; anything else off), over the Threaded rendering row.")
SW(RX_VK_RECORDER_IDLE, attempt, enum, "spin, then a condition variable", "wait: the idle recorder spins 20 us then waits on the ring's address (WaitOnAddress/futex) instead.")
SW(RX_VK_RECORDER_OWN, attempt, bool, "off", "A recording slot resets its own command and descriptor pools at reuse without waiting for the recorder thread.")
SW(RX_VK_RECORDER_PIN, attempt, string, "the recorder thread is not pinned", "Pins the recorder thread to a core: next, sibling (the replay thread's core) or a hex CPU mask.")
SW(RX_VK_RECORDER_POISON, diag, bool, "off", "Poisons the recorder's packet arena after each drain, to catch packets used after they ran.")
SW(RX_VK_RECORDER_RING_MB, tune, int, "8 MB", "Size of the recorder thread's packet ring in MB (at most 1024).")
SW(RX_VK_RECORDER_SPIN_US, tune, int, "adaptive, between 20 and 200 us", "Fixes how long the recorder thread spins with nothing to run before it sleeps, in microseconds.")
SW(RX_VK_RECORDER_STATS, diag, bool, "on: a stats line every 10 s while the recorder thread runs", "=0 turns off the recorder thread's stats log line every 10 seconds.")
SW(RX_VK_RECORD_FLOATS, diag, int, "0: not logged", "Logs this many words (up to 128) of the fragment stage's first uniform buffer as floats for each recorded draw.")
SW(RX_VK_REFLEX, player, enum, "the menu's NVIDIA Reflex row", "Sets NVIDIA Reflex for one run (0 off, 1 on, 2 boost), over the menu row; - does not even enable its extensions.")
SW(RX_VK_REFLEX_LOG, diag, bool, "off", "Logs Reflex's latency timings every 300 frames.")
SW(RX_VK_REFLEX_SUBMIT_IDS, kill, bool, "on (while Reflex is on)", "=0 stops submits being tagged with the Reflex frame id.")
SW(RX_VK_REGISTER_AT_ONCE, kill, bool, "off: registrations are queued in order with the submits", "=1 applies texture and sampler registrations at once on the game's thread, as before.")
SW(RX_VK_REJECT_KEYS, diag, string, "empty: no program rejected", "Comma list of program key prefixes taken as untranslatable, for bisecting a bad translation.")
SW(RX_VK_REJECT_STAGES, diag, string, "empty: no stage rejected", "Comma list of NVN stage numbers whose programs are taken as untranslatable, for bisecting a bad translation.")
SW(RX_VK_RELEASE_DRAIN, kill, bool, "off: texture and program releases are held behind stopped work", "=1 handles releases at once, the old way, not held until the stopped work has run.")
SW(RX_VK_REMADE_SKIP, kill, bool, "off: an evicted texture made again is uploaded from the game's memory", "=1 skips that upload over ranges render targets once took, as before.")
SW(RX_VK_REPLAY_PIN, kill, bool, "on when the host reserves a core (HOS_RESERVE_CORE), otherwise nothing to pin", "=0 stops moving a replaying thread to the processors reserved for the replay.")
SW(RX_VK_RESUME_CAPTURE, kill, bool, "on", "=0: no memory capture when a queue goes on from a CPU event's wait.")
SW(RX_VK_RETIRE_MIN_SECS, tune, int, "2 seconds", "The shorter wait for a retired pool's import while the system heap is past RX_VK_IMPORT_HIGH.")
SW(RX_VK_RETIRE_SECS, tune, int, "30 seconds", "How long a retired (or valve-evicted) pool's import is held before it is freed, in the wait mode.")
SW(RX_VK_REUPLOAD_DIM, diag, string, "off", "Re-uploads every texture of the given <w>x<h> size whole each frame, to test whether write tracking missed a write.")
SW(RX_VK_ROBUST, player, bool, "follows robust_buffers= in hookshot_options.ini; Auto there is on", "0 or 1 overrides the Robust buffers option: bounds-checked buffer access off or on.")
SW(RX_VK_RT_STRICT_PIN, kill, bool, "off: on Windows the render thread may also run on the other fastest-kind cores", "=1 keeps the render thread on the reserved core alone, as before (Windows only).")
SW(RX_VK_SAMPLER_CACHE, player, bool, "the per-thread sampler table on; the parameters' cache per the Debug tab's Sampler cache row", "0 turns off both sampler caches; 1 turns the parameters' cache on, holding the Sampler cache row for the run.")
SW(RX_VK_SEED_CHECK, diag, bool, "off (shader seed closed after the start)", "1 keeps the shader seed open and marks each program miss with the seed stages it holds.")
SW(RX_VK_SHADER_DIR, diag, string, "compiled-in built-in shaders", "Takes each built-in shader from <folder>/<name>.spv when that file is SPIR-V, logging each once.")
SW(RX_VK_SHADOW_BIAS, tune, string, "250000,0 (units,slope) added on character shadow maps", "Sets the depth bias <units>,<slope> added to the characters' shadow maps; 0 leaves the game's own.")
SW(RX_VK_SHADOW_FOLLOWS_SYNC, kill, bool, "on: the write-back shadow takes the same bytes as the mirror's sync", "0 fills the write-back shadow from guest memory at the write-back, as before.")
SW(RX_VK_SHADOW_PCF, kill, bool, "on (comparing samplers made linear: PCF)", "0 keeps the game's own filter on depth-comparison samplers, without the shadow edge softening.")
SW(RX_VK_SHADOW_RAW, kill, bool, "off: shadows are made by the VRAM-pressure rule", "Write-back shadows are made by the count alone, as before the VRAM-pressure rule.")
SW(RX_VK_SHADOW_STAGE, kill, bool, "on: texture pages of a capture are also staged in ordinary cached RAM for the shadow", "0 makes the shadow copies read the capture buffer directly, as before shadow staging.")
SW(RX_VK_SHADOW_SWEEP_OFF, kill, bool, "off: old shadow copies are swept every 256 captures over 32 MB", "1 stops the periodic sweep of shadow page copies no capture took recently; only the 256 MB cap's sweep remains.")
SW(RX_VK_SHARED_48K, kill, bool, "off: shared memory is the size the program declares", "=1 gives every compute program 48 KB of shared memory, as before.")
SW(RX_VK_SHARED_NO_LDS_BARRIER, kill, bool, "off: a subgroup barrier before the first unpredicated LDS after an STS", "Drops the subgroup barrier between a warp's shared-memory store and its read back, as before the fix.")
SW(RX_VK_SHOTS, diag, string, "no screenshots", "Folder for a PNG every RX_VK_SHOT_EVERY presents; also the frame dumps' fallback folder.")
SW(RX_VK_SHOT_EVERY, diag, int, "300 presents", "How often RX_VK_SHOTS writes a PNG, in presents (minimum 1).")
SW(RX_VK_SHOT_FROM, diag, int, "-1: no range", "First present of a range in which every present is shot (with RX_VK_SHOTS and RX_VK_SHOT_TO).")
SW(RX_VK_SHOT_FX, diag, bool, "off", "=1 takes shots through the window's scale pass too, so they show what the window shows.")
SW(RX_VK_SHOT_GO, diag, string, "unset", "<file>: every present is shot while that file exists, for a test's run of frames.")
SW(RX_VK_SHOT_H, diag, int, "720", "Height of the RX_VK_SHOTS screenshots.")
SW(RX_VK_SHOT_MADE, diag, bool, "off", "=1 also writes the interpolated frame before each shot as vk_N_made.png.")
SW(RX_VK_SHOT_MENU, diag, bool, "off", "=1 ticks the Insert menu each present in a headless run and draws it into the shots.")
SW(RX_VK_SHOT_TO, diag, int, "-1: no range", "Last present of the range in which every present is shot (with RX_VK_SHOT_FROM).")
SW(RX_VK_SHOT_W, diag, int, "1280", "Width of the RX_VK_SHOTS screenshots.")
SW(RX_VK_SKIP_CODE, attempt, string, "unset: nothing left out", "Leaves out the draws of every program that has a stage with the listed native code key prefixes.")
SW(RX_VK_SKIP_COMPRESSED_OVER_RT, kill, bool, "off: block-compressed textures are always uploaded from memory", "Restores skipping the first upload of a compressed texture whose storage a render target used before.")
SW(RX_VK_SKIP_FILE, diag, string, "no draws left out", "Names a file of hex program keys whose draws are left out, re-read as it changes, for bisecting in one run.")
SW(RX_VK_SKIP_PROG, diag, string, "unset: program 53509044401d78d2's draws are left out while its targets have no view", "Leaves out the draws and dispatches of programs matching the key prefixes; - leaves out none.")
SW(RX_VK_SLOW_DESC, diag, bool, "off: the clock is not read", "Logs descriptor builds that take over 2 ms, 40 times.")
SW(RX_VK_SLOW_DISPATCH, diag, bool, "off: the clock is not read", "Logs compute dispatches that take over 2 ms, 60 times, with where the time went.")
SW(RX_VK_SLOW_LOG, diag, int, "off (0)", "Logs the replay's times for each frame that took longer than this many ms.")
SW(RX_VK_SPARSE, kill, bool, "sparse resident 2D images used where the queue and device support them", "0 turns off sparse resident images (the terrain's huge arrays); sparse buffers are not affected.")
SW(RX_VK_SPARSE_IDLE, attempt, bool, "off: sparse binds are queued without waiting for the queue to go idle", "Waits for the GPU queue to be idle before each sparse texture bind.")
SW(RX_VK_SPARSE_WAIT, kill, bool, "off: sparse binds signal a timeline semaphore the submissions wait for on the GPU", "1 waits on the CPU for each bind of the sparse mirrors' blocks, as before.")
SW(RX_VK_SPLIT_BEFORE_DRAW, hw, bool, "on for Intel (vendor 0x8086), off elsewhere", "1 ends a submission's part only right before a plain draw; 0 after its 120th draw or dispatch.")
SW(RX_VK_SPLIT_UBFLUSH, hw, bool, "off on Intel without VRAM mirrors (iGPUs), on elsewhere", "1 writes uniform updates into game memory at each part's end; 0 only at the last part's.")
SW(RX_VK_SQUEEZE_ALWAYS, kill, bool, "off: no squeeze while VMA's blocks hold room and the count is within the allowance", "Squeezes the texture budget near the driver's limit even while the allocator's blocks hold free room, as before.")
SW(RX_VK_SSBO_STRETCH, attempt, bool, "off", "Binds a single read-only storage buffer through to its pool's end, up to 64 MB.")
SW(RX_VK_SSBO_WIDE, attempt, int, "0: off", "Binds single storage buffers from their base to the pool's end, at most that many MB.")
SW(RX_VK_STAGING_BURST_S, tune, int, "2 s", "Sets how long recently used staging arenas stay, up to 256 MB, whatever the keep limit; 0 turns that off.")
SW(RX_VK_STAGING_IDLE_S, tune, int, "30 s (5 s while Linux memory pressure is on)", "Sets how many seconds a staging arena may go unused before it counts as stale and is freed; 0 keeps them.")
SW(RX_VK_STAGING_KEEP_MB, hw, int, "128 MB when the driver allows 6.5 GB or less, 256 MB elsewhere", "Sets how many MB of idle staging arenas are kept instead of freed.")
SW(RX_VK_STARTUP_SCREEN, kill, bool, "on: the window shows start-up progress while shaders and pipelines are prepared", "0 goes back to preparing everything before the window shows anything (a console count on Windows).")
SW(RX_VK_START_DELAY, diag, int, "no delay", "Sleeps that many seconds before the replay starts, to imitate a long first start.")
SW(RX_VK_STREAM_GROW_OFF, kill, bool, "recording streams start at 2 MB and grow", "1 keeps the old fixed 24 MB recording stream, skipping draws when it is full instead of growing.")
SW(RX_VK_STREAM_KEEP, kill, bool, "off: extra stream buffers are freed after 120 idle recordings", "Keeps the extra stream buffers a recording slot grew into.")
SW(RX_VK_STREAM_MB, tune, int, "2 MB (24 with RX_VK_STREAM_GROW_OFF=1)", "Size in MB of each recording's first stream buffer.")
SW(RX_VK_SUBMITTED_PAGES, kill, bool, "off: 32 per-thread slots for as-submitted pages", "1 uses one slot for every as-submitted page, as before #1762.")
SW(RX_VK_SUBMIT_DELAY_US, diag, int, "0: no delay", "Spins for that many microseconds before each submit is replayed, to test for data arriving late.")
SW(RX_VK_SYNC_CAPTURE, kill, bool, "on: guest memory captured at each submit", "=0 stops capturing guest memory at the submit, so mirror syncs read memory as it is at the replay.")
SW(RX_VK_SYNC_LIVE, kill, bool, "off: dirty pages come from kept captures where one holds them", "1 reads dirty pages not in their submission's capture from live guest memory, as before.")
SW(RX_VK_SYNC_PIPELINES, attempt, bool, "off (a new pipeline is queued for a worker)", "1 builds each new graphics pipeline in the draw that needs it, not on a worker.")
SW(RX_VK_SYNC_SHADERS, attempt, bool, "off: graphics programs are translated on a worker, compute where they are", "=1 translates every graphics program at its draw, on the drawing thread.")
SW(RX_VK_SYNC_WAITS, kill, bool, "on (unless RX_VK_EVENT_WAITS=0, the render thread, or a dump)", "=0 replays each queue's submission as it comes on the submitting thread, past every wait, as before.")
SW(RX_VK_TAAU_CLAMP, attempt, bool, "off: history not clamped", "Bounds each TAAU stand-in pixel by the last frame's neighbourhood.")
SW(RX_VK_TAAU_FXAA, kill, int, "1: FXAA in the stand-in's shader", "0 gives the plain linear upscale as before; 2 draws the pixels FXAA changed in red.")
SW(RX_VK_TAAU_HIST_LEAK, kill, bool, "off: replaced history images are freed 120 presents later", "Keeps the TAAU history images a new size replaced instead of freeing them, as before the fix.")
SW(RX_VK_TAAU_KEYS, hw, string, "fd029a317a9a4b94 where the network runs on software multiplies (or RX_VK_NO_F16), else '-' (the network runs)", "Program key prefixes whose upscale network is replaced by the renderer's TAAU stand-in; '-' replaces none.")
SW(RX_VK_TABLE_NOW, kill, bool, "off: page table entries are written deferred, not at once", "1 writes the guest page table's entries at once, as before the deferred writes became the default.")
SW(RX_VK_TARGET_BLOCKS, kill, bool, "on: render targets' images come from memory blocks of their own", "=0 puts render targets' images in the general image pool's blocks, as before.")
SW(RX_VK_TARGET_POOL_MB, hw, int, "a twelfth of the VRAM the driver allows, 256 to 768 MB", "Cap, in MB, on the pool of render targets kept for reuse.")
SW(RX_VK_TASK_CAP, tune, int, "0: one mesh workgroup per task thread", "Caps how many mesh workgroups a task program may start at <n> instead of one per task thread.")
SW(RX_VK_TASK_MESH_FALLBACK, hw, bool, "on for AMD Navi 21-23 (RDNA 2) on Windows, off elsewhere; off with RX_VK_MESH_SHADERS=native", "1 runs task + mesh draws through the compute fallback on a GPU with mesh shaders; 0 uses the driver's mesh shaders.")
SW(RX_VK_TEST_ALLOWED_FILE, diag, string, "off", "Reads the VRAM allowance cap in MB from a file once a second, so a test can shrink it during play.")
SW(RX_VK_TEST_ALLOWED_FOLLOW, diag, bool, "off", "With a test allowance set, reports an exceeded allowance as the count itself, imitating AMD's Windows driver.")
SW(RX_VK_TEST_ALLOWED_MB, diag, int, "off: the driver's allowance is used", "Caps the VRAM allowance the renderer sees at n MB, so a big card exercises a small card's eviction paths.")
SW(RX_VK_TEST_SLOW_MS, diag, int, "off (no hold)", "Holds each full pipeline build this many ms (at most 60000), to imitate a slow driver compiler.")
SW(RX_VK_TEST_VRAM_MB, diag, int, "the card's real VRAM", "Treats the card's VRAM as at most n MB wherever the renderer sizes something by it, to play a smaller card.")
SW(RX_VK_TEX_CAPTURE, kill, bool, "on, when the capture is on", "0 keeps the storage of textures uploaded from guest memory out of the submit-time capture.")
SW(RX_VK_TEX_CAPTURE_MAX_MB, tune, int, "2048 MB, in effect any size", "Sets the largest uploaded texture whose storage joins the submit-time memory capture; it was 8 MB before.")
SW(RX_VK_TEX_CAPTURE_OFF_FILE, diag, string, "not set: uploads read the captured copies", "A path: while that file exists, texture uploads read live guest memory as before, for A/B runs in one session.")
SW(RX_VK_TEX_MAX_DIM, hw, int, "2048; 1024 on Minimum settings when the driver allows 4.5 GB or less (or an iGPU with 16 GB RAM or less)", "Width above which a big decoded ASTC texture leaves out its top mip levels.")
SW(RX_VK_TEX_MAX_MB, tune, int, "1536 MB", "Size in MB down to which any texture leaves out top mip levels, whatever its width.")
SW(RX_VK_TEX_SKIP_MB, hw, int, "64 MB; 8 on Minimum settings when the driver allows 4.5 GB or less (or an iGPU with 16 GB RAM or less)", "Size as RGBA8, in MB, from which a decoded ASTC texture wider than the max width loses top levels.")
SW(RX_VK_TIMELINE, diag, int, "off: no timeline lines", "Logs one frame's jobs every 240 presents (hand-over, wait, duration, draws); 2 and up adds the late variant.")
SW(RX_VK_TRACE_TEX, diag, string, "no tracing", "A list of <w>x<h> sizes: draws sampling textures of all those sizes are logged with their state.")
SW(RX_VK_TRANSLATE_WAIT_MS, attempt, float, "off: shaders still translating are waited out", "Bounds, in ms a frame per recording thread, the wait for translating shaders before their draws are left out.")
SW(RX_VK_TS_GLOBAL, attempt, bool, "off: timestamps scaled from each frame's present", "=1 scales GPU timestamps from the first one read rather than from each present.")
SW(RX_VK_TS_SCALE, tune, float, "0.1", "Scale of the GPU timestamp clock the game's dynamic resolution reads, counted from each present; 1 is the real clock.")
SW(RX_VK_UB_CUR_ONLY, attempt, bool, "off: every pending uniform update is overlaid", "=1 overlays only the current submission's uniform updates on a buffer read (an A/B).")
SW(RX_VK_UB_READ_BATCH, kill, enum, "1: a draw's uniform copies read together once", "0 reads each uniform copy where it is asked, as before; 2 does both and counts differences in the log.")
SW(RX_VK_UB_SNAPSHOT, hw, bool, "on for Intel (iGPUs and Arc), off elsewhere", "1 copies each uniform buffer into the stream as submitted; 0 binds it where the game keeps it.")
SW(RX_VK_UB_SNAP_DEDUP, kill, enum, "1: one copy of a uniform range per recording", "0 makes a uniform copy for every binding, as before; 2 copies every time and counts differences in the log.")
SW(RX_VK_UB_WORD_HASH, kill, bool, "on: the word cache index mixes higher address bits", "=0 indexes the uniform-update word cache by the low seven word bits only, as before.")
SW(RX_VK_UI_GAME_FONT, kill, bool, "on: the game's own fonts where its files have all three", "=0 draws the menu, counter and start-up screen in the included Libertinus.")
SW(RX_VK_UI_PROMPTS, diag, enum, "prompts follow the device used last", "Forces the menu's button prompts to controller (pad) or keyboard (keys), for screenshots of test runs.")
SW(RX_VK_UNEVEN_BC, attempt, bool, "AMD uneven-BC-level fix off: BC3 as in v2.0.4", "=0 turns on resizing of ASTC-as-BC3 textures whose mip block grids do not halve evenly (the AMD seam-lines fix), on every card.")
SW(RX_VK_UNEVEN_RGBA8, attempt, bool, "off: uneven textures are resized (when the fix is on)", "With RX_VK_UNEVEN_BC=0, keeps uneven-level textures as RGBA8 instead of resizing them for BC3.")
SW(RX_VK_UNSWIZZLE_CHECK, diag, bool, "off: no check", "=1 checks each threaded unswizzle against a single-thread one and logs whether they match.")
SW(RX_VK_UPLOAD_ALL, kill, bool, "off: storage last written by GPU render targets and untouched by the CPU is not uploaded", "Uploads new textures from guest memory even when that storage was last a GPU render target's (an A/B switch).")
SW(RX_VK_UPLOAD_BUDGET_MS, tune, float, "12 ms of uploads a frame, then new small ASTC textures wait a frame", "Sets the per-frame upload time after which new non-terrain ASTC textures are deferred to a later frame; 0 means no deferral.")
SW(RX_VK_UPSCALE, player, int, "the upscaling filter row", "Chooses the upscaling filter (0 to 2) for one run, over the options file.")
SW(RX_VK_UPSCALE_LOD_BIAS, kill, bool, "on (upscalers add a texture LOD bias for their render share)", "0 turns off the extra texture LOD bias added for DLSS, FSR 3.1 and FSR 4.")
SW(RX_VK_UPSCALE_LOG, diag, bool, "off", "Logs once the upscale filter's mode, sharpness, source, crop and destination sizes.")
SW(RX_VK_VALIDATION, diag, bool, "off", "Enables the Khronos validation layer on the Vulkan instance.")
SW(RX_VK_VB_RANGE, kill, bool, "on: only the vertex bindings that changed are bound", "=0 binds all 16 vertex bindings again at each change, as before.")
SW(RX_VK_VERIFY_DIM, diag, string, "no verification", "WxH: hashes the guest memory of textures that size at upload and every 300 frames, logging writes the tracking missed.")
SW(RX_VK_VRAM_MB, hw, int, "by rule from the driver's allowance, the card's VRAM, system RAM and integrated or not (texture_budget.h)", "Sets the texture budget in MB for a test, in place of the hardware rule.")
SW(RX_VK_WAIT_GPU, attempt, int, "0: the replay is not held to the GPU", "<frames> keeps the replay no further ahead of the GPU than that many frames (at most 8).")
SW(RX_VK_WAIT_HOLD_US, tune, int, "3000 microseconds", "How long a game wait that needs stopped work gives another queue's submit before forcing it on.")
SW(RX_VK_WARP64, hw, bool, "long warp path where the GPU's subgroups can exceed 32 lanes, except in stages pinned to 32", "0 or 1 forces the graphics stages' long warp path off or on, whatever the GPU.")
SW(RX_VK_WATCH_ADDRS, diag, string, "empty: none watched", "Watches fixed guest addresses (hex list) in the measured statistics frame.")
SW(RX_VK_WATCH_ARGS_OF, diag, string, "empty: none watched", "Watches the indirect-argument addresses of the listed programs in the measured statistics frame.")
SW(RX_VK_WATCH_CPU, diag, string, "no watch", "<present>:<hex gpu addresses>: from that present on, logs CPU writes to those 4 KB pages with the writer's stack.")
SW(RX_VK_WATCH_DIM, diag, string, "unset: no size watched", "<w>x<h>: logs what happens to textures of that size, as RX_VK_WATCH_TEX does by address.")
SW(RX_VK_WATCH_GPU_WRITE, diag, string, "off", "Logs up to 60 GPU buffer writes reaching the given hex address range <lo>[:<hi>], by program.")
SW(RX_VK_WATCH_PROG, diag, string, "empty: nothing watched", "Keeps the last 40 binding notes of the listed programs and logs them when the device is lost.")
SW(RX_VK_WATCH_RANGE, diag, string, "unset: nothing logged", "<lo>:<hi> in hex logs buffer copies, clears, textures and texel reads/writes touching that GPU address range.")
SW(RX_VK_WATCH_SB, diag, string, "empty: none watched", "Watches a compute program's storage buffer slot and offset (<prog>:<slot>:<offset>, two at most).")
SW(RX_VK_WATCH_TEX, diag, string, "unset: nothing watched", "Comma list of hex GPU addresses: logs what happens to the textures over them, up to 600 lines.")
SW(RX_VK_WB_DIFF, kill, bool, "on", "=0 makes write-backs copy every byte again instead of only what changed against a VRAM shadow.")
SW(RX_VK_WB_MAX_KB, tune, int, "1024 KB", "Size in KB from which a GPU-written binding is written back only where the CPU reads or writes it; 0 turns that off.")
SW(RX_VK_WB_OBSERVE, diag, bool, "off", "Measures and logs actual mirror/shadow differences in the write-back diff pass every 600 submissions.")
SW(RX_VK_WB_PROBATION, tune, int, "8 submissions (wb_learn.h's table default)", "How many submissions write a large binding back whole before it may be left out of the write-back.")
SW(RX_VK_WB_REPORTS, kill, bool, "off: words the CPU owns are left out of the mirrors' write-back", "1 writes CPU-owned report words back with the rest of a mirror, as before.")
SW(RX_VK_WB_SHADOW_MB, hw, int, "1/8 of the allowed VRAM (512 MB if unknown); at most 512 MB on an integrated GPU", "The most VRAM the write-back diff's shadows may take, in MB.")
SW(RX_VK_WORKERS, hw, int, "6 with 16 hardware threads or more, else a third of them clamped to 2-4", "Number of background workers for shader translation and pipeline builds (1 to 16).")
SW(RX_VK_XESS, player, enum, "unset: the Insert menu's Upscaler row chooses", "0 keeps XeSS out for the run (library not loaded), 1 forces Intel XeSS over the row, 2 its Native AA.")
SW(RX_VK_XESS_DIR, attempt, string, "libxess.dll is looked for beside the executable, then in the game folder", "Names a folder searched first for Intel's libxess.dll.")
SW(RX_VK_XESS_HDR, kill, bool, "on: XeSS gets an HDR context when the game presents native HDR", "=0 makes XeSS use the LDR context and clamped colour even with native HDR.")
SW(RX_VK_ZERO_HOLES, kill, bool, "on (Linux): never-written holes in guest memory are skipped by the all-zero check", "=0 reads the whole storage in the all-zero check, as before.")
SW(RX_VK_ZERO_UPLOAD, kill, bool, "on: a texture of 32 MB or more whose storage is all zero is cleared on the GPU", "=0 unswizzles and uploads all-zero big textures like any other.")
GONE(RX_VK_DESC_REUSE_DGEN, "2026-11-11", "it does nothing")
GONE(RX_VK_DESC_SLOTGEN, "2026-11-11", "use RX_VK_DESC_REUSE (the same 0 and 1) or the Descriptor reuse row")
GONE(RX_VK_FOLLOW_MESH, "2026-11-11", "it does nothing")
GONE(RX_VK_GPU_PROFILE, "2026-11-16", "use RX_VK_PASS_TIMING=1, which it was another name for")
GONE(RX_VK_NO_DESC_REUSE, "2026-11-11", "use RX_VK_DESC_REUSE=never")
GONE(RX_VK_NO_NAN_GUARD, "2026-11-11", "use RX_VK_NAN_GUARD=0")
GONE(RX_VK_OOT, "2026-11-11", "it does nothing")
GONE(RX_VK_OOT_EXPOSURE, "2026-11-11", "it does nothing")
GONE(RX_VK_OOT_FOG, "2026-11-11", "it does nothing")
GONE(RX_VK_OOT_VISUAL, "2026-11-11", "it does nothing")
